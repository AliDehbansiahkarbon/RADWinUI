program WinMDGen;

(*
  Command line: WinMDGen --winmd <file or folder> [--winmd ...] --out <folder>
    [--unit RADWinUI.Abi] [--namespace Microsoft.UI ...] [--xaml-unit RADWinUI.Xaml] [--sdk <text>]
  Writes the ABI projection, the XAML wrappers and the XamlCodeGen type index.
*)

{$APPTYPE CONSOLE}

uses
  System.SysUtils, System.Classes, System.IOUtils, System.Types,
  RADWinUI.WinMD.Metadata in 'RADWinUI.WinMD.Metadata.pas',
  RADWinUI.WinMD.Model in 'RADWinUI.WinMD.Model.pas',
  RADWinUI.WinMD.Pascal in 'RADWinUI.WinMD.Pascal.pas',
  RADWinUI.WinMD.Xaml in 'RADWinUI.WinMD.Xaml.pas';

function Collect(const APaths: TArray<string>): TArray<string>;
var
  P, F: string;
  Found: TArray<string>;
  Contracts: Boolean;
begin
  Result := nil;
  for P in APaths do
  begin
    if TDirectory.Exists(P) then
      Found := TDirectory.GetFiles(P, '*.winmd', TSearchOption.soAllDirectories)
    else if TFile.Exists(P) then
      Found := [P]
    else
      Found := nil;
    SortOrdinal(Found);
    Result := Result + Found;
  end;
  // Windows.winmd is the union of the contract files, prefer the contracts.
  Contracts := False;
  for F in Result do
    if TPath.GetFileName(F).ToLower.EndsWith('contract.winmd') then
      Contracts := True;
  if Contracts then
  begin
    Found := Result;
    Result := nil;
    for F in Found do
      if TPath.GetFileName(F).ToLower <> 'windows.winmd' then
        Result := Result + [F];
  end;
end;

procedure WriteUtf8NoBom(const APath, AText: string);
var
  Bytes: TBytes;
begin
  Bytes := TEncoding.UTF8.GetBytes(AText);
  TFile.WriteAllBytes(APath, Bytes);
end;

function Run: Integer;
var
  I: Integer;
  Arg, OutDir, UnitName, XamlUnit, Sdk, Header, Text, Path, Name: string;
  WinMDs, Namespaces, Files: TArray<string>;
  U: TUniverse;
  Proj: TProjection;
  Wrappers: TXamlWrappers;
  TypeCount: Integer;
begin
  UnitName := 'RADWinUI.Abi';
  XamlUnit := 'RADWinUI.Xaml';
  I := 1;
  while I <= ParamCount do
  begin
    Arg := ParamStr(I);
    if I = ParamCount then
      raise Exception.Create('missing value for ' + Arg);
    Inc(I);
    if Arg = '--winmd' then WinMDs := WinMDs + [ParamStr(I)]
    else if Arg = '--out' then OutDir := ParamStr(I)
    else if Arg = '--unit' then UnitName := ParamStr(I)
    else if Arg = '--namespace' then Namespaces := Namespaces + [ParamStr(I)]
    else if Arg = '--xaml-unit' then XamlUnit := ParamStr(I)
    else if Arg = '--sdk' then Sdk := ParamStr(I)
    else
      raise Exception.Create('unknown option ' + Arg);
    Inc(I);
  end;
  if (Length(WinMDs) = 0) or (OutDir = '') then
  begin
    Writeln(ErrOutput, 'usage: WinMDGen --winmd <file or folder> [--winmd ...] --out <folder> [--unit name] ' +
      '[--namespace ns ...] [--xaml-unit name] [--sdk text]');
    Exit(2);
  end;
  if Length(Namespaces) = 0 then
    Namespaces := ['Microsoft.UI', 'Microsoft.Foundation', 'Microsoft.Graphics', 'Windows.Foundation'];
  Files := Collect(WinMDs);
  if Length(Files) = 0 then
  begin
    Writeln(ErrOutput, 'no .winmd files found');
    Exit(2);
  end;
  if Sdk = '' then
    Sdk := 'see build/WindowsAppSDK.json';
  Header := UnitName + ': Windows Runtime ABI projection for Delphi.'#10#10 +
    'Generated by tools/WinMDGen. Do not edit; regenerate instead.'#10 +
    'Source metadata: ' + Sdk + #10;
  U := TUniverse.Create(Files);
  try
    Proj := TProjection.Create(U, UnitName, Namespaces, Header);
    try
      Text := Proj.Emit;
      ForceDirectories(OutDir);
      Path := TPath.Combine(OutDir, UnitName + '.pas');
      WriteUtf8NoBom(Path, Text);
      for Name in Proj.Unknown.Keys.ToArray do
        Writeln('warning: ', Name, ' is not in the loaded metadata; projected as Pointer');
      Writeln(Format('%s: %d types, %d generic instances, %d external value types',
        [Path, Proj.Included.Count, Proj.Instances.Count, Proj.ValueTypes.Count]));

      Wrappers := TXamlWrappers.Create(Proj, XamlUnit, Header.Replace(
        UnitName + ': Windows Runtime ABI projection for Delphi.',
        XamlUnit + ': Delphi wrapper classes for the XAML runtime classes.'));
      try
        Text := Wrappers.Emit;
        Path := TPath.Combine(OutDir, XamlUnit + '.pas');
        WriteUtf8NoBom(Path, Text);
        Writeln(Format('%s: %d wrapper classes, %d event types',
          [Path, Length(Wrappers.Classes), Wrappers.EventTypes.Count]));
        Text := Wrappers.TypeIndex(TypeCount);
        Path := TPath.Combine(OutDir, XamlUnit + '.json');
        WriteUtf8NoBom(Path, Text);
        Writeln(Format('%s: %d XAML types for XamlCodeGen', [Path, TypeCount]));
      finally
        Wrappers.Free;
      end;
    finally
      Proj.Free;
    end;
  finally
    U.Free;
  end;
  Result := 0;
end;

begin
  try
    ExitCode := Run;
  except
    on E: Exception do
    begin
      Writeln(ErrOutput, E.ClassName, ': ', E.Message);
      ExitCode := 1;
    end;
  end;
end.
