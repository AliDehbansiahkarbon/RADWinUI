procedure TWinUIUIElement._HookAccessKeyDisplayDismissed;
begin
  if F_AccessKeyDisplayDismissedToken.Value <> 0 then
    Exit;
  F_AccessKeyDisplayDismissedToken := _IUIElement.add_AccessKeyDisplayDismissed(RADWinUI.Abi.TTypedEventHandler_UIElement_AccessKeyDisplayDismissedEventArgs.Create(
    procedure(ASender: RADWinUI.Abi.IUIElement; AArgs: RADWinUI.Abi.IAccessKeyDisplayDismissedEventArgs)
    var
      E: TWinUIAccessKeyDisplayDismissedEventArgs;
    begin
      // Args wrappers live for one call; handlers must not keep them
      E := TWinUIAccessKeyDisplayDismissedEventArgs(TWinUIObject.Wrap(nil, AArgs, TWinUIAccessKeyDisplayDismissedEventArgs));
      try
        if Assigned(F_OnAccessKeyDisplayDismissed) then
          F_OnAccessKeyDisplayDismissed(Self, E);
        if F_AccessKeyDisplayDismissed <> nil then
          F_AccessKeyDisplayDismissed.Invoke(Self, E);
      finally
        E.Free;
      end;
    end));
end;

