  if F_Opened = nil then
  begin
    F_Opened := TWinUIEvent<TWinValue>.Create;
    AddHelper(F_Opened);
    _HookOpened;
  end;
  Result := F_Opened;
end;

procedure TWinUICalendarDatePicker.DetachEvents;
begin
  if F_CalendarViewDayItemChangingToken.Value <> 0 then
    _ICalendarDatePicker.remove_CalendarViewDayItemChanging(F_CalendarViewDayItemChangingToken);
  if F_ClosedToken.Value <> 0 then
    _ICalendarDatePicker.remove_Closed(F_ClosedToken);
  if F_DateChangedToken.Value <> 0 then
    _ICalendarDatePicker.remove_DateChanged(F_DateChangedToken);
  if F_OpenedToken.Value <> 0 then
    _ICalendarDatePicker.remove_Opened(F_OpenedToken);
  inherited;
end;

procedure TWinUICalendarDatePicker.SetDisplayDate(ADate: TWinUIDateTime);
begin
  _ICalendarDatePicker.SetDisplayDate(ADate);
end;

procedure TWinUICalendarDatePicker.SetYearDecadeDisplayDimensions(AColumns: Integer; ARows: Integer);
begin
  _ICalendarDatePicker.SetYearDecadeDisplayDimensions(AColumns, ARows);
end;

