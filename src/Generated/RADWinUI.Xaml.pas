begin
  if F_ICompositionCapabilities = nil then
    F_ICompositionCapabilities := WinRTObject as RADWinUI.Abi.ICompositionCapabilities;
  Result := F_ICompositionCapabilities;
end;

procedure TWinUICompositionCapabilities._HookChanged;
begin
  if F_ChangedToken.Value <> 0 then
    Exit;
  F_ChangedToken := _ICompositionCapabilities.add_Changed(RADWinUI.Abi.TTypedEventHandler_CompositionCapabilities_Object.Create(
    procedure(ASender: RADWinUI.Abi.ICompositionCapabilities; AArgs: IInspectable)
    begin
      if Assigned(F_OnChanged) then
        F_OnChanged(Self, AArgs);
      if F_Changed <> nil then
        F_Changed.Invoke(Self, AArgs);
    end));
end;

procedure TWinUICompositionCapabilities._SetOnChanged(const AValue: TWinUIWinValueEventHandler);
begin
  F_OnChanged := AValue;
  if Assigned(AValue) then
    _HookChanged;
end;

function TWinUICompositionCapabilities._GetChanged: TWinUIEvent<TWinValue>;
begin
  if F_Changed = nil then
  begin
    F_Changed := TWinUIEvent<TWinValue>.Create;
    AddHelper(F_Changed);
    _HookChanged;
  end;
  Result := F_Changed;
end;

procedure TWinUICompositionCapabilities.DetachEvents;
begin
  if F_ChangedToken.Value <> 0 then
    _ICompositionCapabilities.remove_Changed(F_ChangedToken);
  inherited;
end;

