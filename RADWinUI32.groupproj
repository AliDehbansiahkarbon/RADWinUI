<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!--
      Everything RADWinUI needs in the classic 32-bit IDE, built from source.
      Open this group, Build All, then right-click RADWinUIWizard32.bpl > Install. The 64-bit IDE
      uses RADWinUI.groupproj. Every project has one platform (the tools are Win64), so Build All
      needs no platform choice.
    -->
    <PropertyGroup>
        <ProjectGuid>{154865D2-7AAA-4991-BE89-A662062DFF95}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="tools\XamlCodeGen\XamlCodeGen.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="src\IDE\Preview\RADWinUIPreview.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="packages\RADWinUIWizard32.dproj">
            <Dependencies>tools\XamlCodeGen\XamlCodeGen.dproj;src\IDE\Preview\RADWinUIPreview.dproj</Dependencies>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="XamlCodeGen">
        <MSBuild Projects="tools\XamlCodeGen\XamlCodeGen.dproj"/>
    </Target>
    <Target Name="XamlCodeGen:Clean">
        <MSBuild Projects="tools\XamlCodeGen\XamlCodeGen.dproj" Targets="Clean"/>
    </Target>
    <Target Name="XamlCodeGen:Make">
        <MSBuild Projects="tools\XamlCodeGen\XamlCodeGen.dproj" Targets="Make"/>
    </Target>
    <Target Name="RADWinUIPreview">
        <MSBuild Projects="src\IDE\Preview\RADWinUIPreview.dproj"/>
    </Target>
    <Target Name="RADWinUIPreview:Clean">
        <MSBuild Projects="src\IDE\Preview\RADWinUIPreview.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RADWinUIPreview:Make">
        <MSBuild Projects="src\IDE\Preview\RADWinUIPreview.dproj" Targets="Make"/>
    </Target>
    <Target Name="RADWinUIWizard32" DependsOnTargets="XamlCodeGen;RADWinUIPreview">
        <MSBuild Projects="packages\RADWinUIWizard32.dproj"/>
    </Target>
    <Target Name="RADWinUIWizard32:Clean" DependsOnTargets="XamlCodeGen:Clean;RADWinUIPreview:Clean">
        <MSBuild Projects="packages\RADWinUIWizard32.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RADWinUIWizard32:Make" DependsOnTargets="XamlCodeGen:Make;RADWinUIPreview:Make">
        <MSBuild Projects="packages\RADWinUIWizard32.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="XamlCodeGen;RADWinUIPreview;RADWinUIWizard32"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="XamlCodeGen:Clean;RADWinUIPreview:Clean;RADWinUIWizard32:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="XamlCodeGen:Make;RADWinUIPreview:Make;RADWinUIWizard32:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
