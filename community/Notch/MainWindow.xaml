<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rw="using:RADWinUI.Controls"
    x:Class="TMainWindow" Title="Notch" Width="720" Height="300"
    WindowStyle="Overlay" Backdrop="Transparent" ClickThrough="Background" ShowActivated="False">
  <!-- A desk companion that hangs from the top of the screen: a black pill with
       the time, which opens into a panel of widgets the user picks: app
       shortcuts, AI agents, remote desktops, the calendar, links, notes, the
       music playing on the PC and a focus timer. Ctrl+Alt+N opens and closes it.
       The window has no Dock: MainWindow.pas puts it against the edge the user
       picked or dragged it to. -->
  <Grid RequestedTheme="Dark" Background="Transparent">
    <Grid.Resources>
      <SolidColorBrush x:Key="TileBrush" Color="#161618"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#8E8E93"/>
      <SolidColorBrush x:Key="FaintBrush" Color="#2C2C2E"/>
    </Grid.Resources>

    <rw:NotchPanel x:Name="Notch" CollapsedWidth="220" CollapsedHeight="36" ExpandedWidth="680" ExpandedHeight="276"
                   ExpandedCornerRadius="30" Padding="22,14,22,18"
                   IsExpanded="False">
      <rw:NotchPanel.Pill>
        <!-- Pressing on the pill drags the notch to another place -->
        <Grid x:Name="PillHost" Background="Transparent">
          <Grid x:Name="PillGrid" Width="196" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="PillDot" Width="8" Height="8" Fill="#3DDC84" VerticalAlignment="Center"/>
            <TextBlock x:Name="PillClock" Grid.Column="1" Text="00:00" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <FontIcon x:Name="PillMusic" Grid.Column="2" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8D6;"
                      FontSize="12" Foreground="#2EC4B6" Opacity="0" VerticalAlignment="Center"/>
          </Grid>
          <!-- On the left and right edges the pill stands upright -->
          <StackPanel x:Name="PillSide" Visibility="Collapsed" Spacing="4" HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <Ellipse x:Name="PillSideDot" Width="8" Height="8" Fill="#3DDC84" HorizontalAlignment="Center"/>
            <TextBlock x:Name="PillHours" Text="00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="PillMinutes" Text="00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </rw:NotchPanel.Pill>

      <!-- Arrow keys move between tiles and their buttons when the notch has the keyboard -->
      <Grid RowSpacing="14" XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: date, time, transparency, edit, pin and quit. Pressing on it drags the notch.
             The tools sit right of the clock, or below it when the panel stands upright. -->
        <Grid x:Name="HeaderBar" ColumnSpacing="8" RowSpacing="10" Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock x:Name="ClockLabel" Text="00:00" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="DateLabel" Text="Thursday, 29 October" FontSize="13" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Bottom" Margin="0,0,0,3"/>
          </StackPanel>
          <StackPanel x:Name="HeaderTools" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="HotKeyHint" Text="Ctrl+Alt+N" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <!-- Off, the notch is solid black. On, the desktop shows through it -->
            <ToggleSwitch x:Name="TransparencySwitch" OnContent="Transparency" OffContent="Transparency"
                          MinWidth="0" FontSize="12" VerticalAlignment="Center" AutomationProperties.Name="Transparency"/>
            <Slider x:Name="TransparencySlider" Width="96" Minimum="10" Maximum="90" StepFrequency="1"
                    VerticalAlignment="Center" Visibility="Collapsed" ToolTipService.ToolTip="How see-through"
                    AutomationProperties.Name="Transparency level"/>
            <Button x:Name="EditButton" Width="32" Height="32" Padding="0" CornerRadius="16"
                    Background="{StaticResource FaintBrush}" BorderThickness="0" ToolTipService.ToolTip="Edit widgets">
              <FontIcon x:Name="EditGlyph" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="13"/>
            </Button>
            <Button x:Name="PinButton" Width="32" Height="32" Padding="0" CornerRadius="16"
                    Background="{StaticResource FaintBrush}" BorderThickness="0" ToolTipService.ToolTip="Keep open">
              <FontIcon x:Name="PinGlyph" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE718;" FontSize="13"/>
            </Button>
            <Button x:Name="QuitButton" Width="32" Height="32" Padding="0" CornerRadius="16"
                    Background="{StaticResource FaintBrush}" BorderThickness="0" ToolTipService.ToolTip="Quit">
              <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE711;" FontSize="12"/>
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <!-- The widgets the user picked, built from the settings at runtime. The
               margins leave room for the glow of the tiles. -->
          <ScrollViewer x:Name="WidgetScroller" Margin="-22,-8,-22,-18" HorizontalScrollMode="Auto"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="WidgetRow" Orientation="Horizontal" Spacing="14" Margin="22,8,22,18"
                        XYFocusKeyboardNavigation="Enabled"/>
          </ScrollViewer>

          <!-- Edit page: inside the notch, because the window only takes clicks there -->
          <!-- Side by side when the panel is wide, one above the other when it stands upright -->
          <Grid x:Name="EditPage" Visibility="Collapsed" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="270"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="0"/>
            </Grid.RowDefinitions>
            <Grid RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Widgets" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border x:Name="WidgetListHost"/>
              </ScrollViewer>
              <TextBlock Grid.Row="2" Text="Add a widget" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
              <Border x:Name="AddListHost" Grid.Row="3"/>
            </Grid>
            <Grid x:Name="DetailPanel" Grid.Column="1" RowSpacing="10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TitleBox" PlaceholderText="Name of the widget" AutomationProperties.Name="Name of the widget"/>
                <TextBlock x:Name="DetailHint" Grid.Column="1" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
              </Grid>
              <ScrollViewer Grid.Row="1" MaxHeight="92" VerticalScrollBarVisibility="Auto">
                <Border x:Name="ItemListHost"/>
              </ScrollViewer>
              <Grid x:Name="EntryForm" Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="2*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="EntryNameBox" PlaceholderText="Name" AutomationProperties.Name="Name"/>
                <TextBox x:Name="EntryTargetBox" Grid.Column="1" PlaceholderText="Address"
                         AutomationProperties.Name="Address"/>
                <Button x:Name="AddEntryButton" Grid.Column="2" Content="Add" CornerRadius="8"/>
              </Grid>
              <TextBox x:Name="SearchBox" Grid.Row="3" PlaceholderText="Search installed apps"
                       AutomationProperties.Name="Search installed apps"/>
              <ScrollViewer x:Name="AppResults" Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <Border x:Name="AppResultsHost"/>
              </ScrollViewer>
            </Grid>
            <!-- The notch's own settings, in place of a widget's -->
            <ScrollViewer x:Name="SettingsPage" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <Border x:Name="SettingsHost"/>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </rw:NotchPanel>

    <rw:HotKey x:Name="ToggleKey" Keys="Ctrl+Alt+N"/>
    <rw:MediaSession x:Name="Media"/>
  </Grid>
</Window>
