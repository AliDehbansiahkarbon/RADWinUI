                <Border Grid.Column="1" Style="{StaticResource Inner}" Padding="10,12">
                  <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="4,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource TealBrush}"/>
