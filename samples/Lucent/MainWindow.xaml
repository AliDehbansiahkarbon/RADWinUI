                      </StackPanel>
                      <Button Style="{StaticResource RoundInner}" Width="28" Height="28" HorizontalAlignment="Right" Tag="0" Click="ColumnAddClick" AutomationProperties.Name="Add to In development">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="10"/>
                      </Button>
                    </Grid>
                    <ListView x:Name="Column0" Grid.Row="1" Tag="0" SelectionMode="None" CanDragItems="True" AllowDrop="True" ItemContainerStyle="{StaticResource Bare}" ItemTemplate="{StaticResource ReleaseCard}"
