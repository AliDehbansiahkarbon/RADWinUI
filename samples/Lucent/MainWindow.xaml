                  <RepositionThemeTransition/>
                </TransitionCollection>
              </GridView.ItemContainerTransitions>
              <GridView.ItemTemplate>
                <DataTemplate x:DataType="TMember">
                  <Border Width="268" Padding="20" CornerRadius="26" Background="{ThemeResource GlassBrush}" BorderBrush="{ThemeResource GlassRimBrush}" BorderThickness="1">
