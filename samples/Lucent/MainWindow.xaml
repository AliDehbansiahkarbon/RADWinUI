              <Border CornerRadius="24" Margin="-6" Opacity="0.55">
                <Border.Background>
                  <RadialGradientBrush>
                    <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                  </RadialGradientBrush>
                </Border.Background>
              </Border>
              <Button x:Name="NewReleaseButton" Style="{StaticResource Accent}" Click="RailNewClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="12"/>
