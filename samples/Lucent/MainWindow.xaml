                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xF0E2;" FontSize="12"/>
                    <TextBlock Text="Board"/>
                  </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ViewTimeline" Style="{StaticResource Chip}" Click="ViewClick" BorderThickness="0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE81C;" FontSize="12"/>
                    <TextBlock Text="Timeline"/>
                  </StackPanel>
                </ToggleButton>
              </StackPanel>
            </Border>
          </Grid>
          <Border x:Name="BoardCard" Style="{StaticResource Glass}" Padding="20,18">
            <Grid RowSpacing="14">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Board" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="Drag a card to move it" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
              </StackPanel>
              <Grid Grid.Row="1" ColumnSpacing="14" MinHeight="520">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Inner}" Padding="10,12">
                  <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
