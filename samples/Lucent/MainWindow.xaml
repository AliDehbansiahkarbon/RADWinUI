                            <Ellipse.Fill>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4DFFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                              </LinearGradientBrush>
                            </Ellipse.Fill>
                          </Ellipse>
                          <TextBlock Text="{Binding Initials}" FontSize="19" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Ellipse Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{ThemeResource GoodBrush}" Stroke="{ThemeResource GlassRimBrush}" StrokeThickness="2"
                                   Visibility="{Binding Online, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="10" Padding="9,3" Background="{ThemeResource InnerBrush}">
                          <TextBlock Text="{Binding Access}" FontSize="11"/>
                        </Border>
                      </Grid>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Role}" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                      </StackPanel>
                      <Border Style="{StaticResource Inner}" Padding="12,8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="Looks after" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
                          <TextBlock Text="{Binding Apps}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Border>
                      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </GridView.ItemTemplate>
            </GridView>
            <Border x:Name="ActivityCard" Grid.Column="1" Style="{StaticResource Glass}" VerticalAlignment="Top">
              <StackPanel Spacing="10">
                <Grid>
                  <TextBlock Text="Activity" Style="{StaticResource CardTitle}"/>
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource GoodBrush}"/>
                    <TextBlock Text="Live" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
                  </StackPanel>
                </Grid>
                <ItemsControl x:Name="ActivityList">
                  <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection><AddDeleteThemeTransition/><RepositionThemeTransition/></TransitionCollection>
                  </ItemsControl.ItemContainerTransitions>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="TNotice">
                      <Grid Padding="0,9" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{ThemeResource InnerBrush}">
                          <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="{Binding Glyph}" FontSize="13"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- A toast for live events -->
    <Border x:Name="Toast" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,26" Width="340"
            Padding="16,12" CornerRadius="20" Background="{ThemeResource GlassStrongBrush}" BorderBrush="{ThemeResource GlassRimBrush}" BorderThickness="1"
            IsHitTestVisible="False">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Width="36" Height="36">
          <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
          <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="{Binding ToastGlyph}" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="ToastTitleLabel" Text="{Binding ToastTitle}" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ToastBody}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
