                      </StackPanel>
                      <Button Style="{StaticResource RoundInner}" Width="28" Height="28" HorizontalAlignment="Right" Tag="3" Click="ColumnAddClick" AutomationProperties.Name="Add to Ready for release">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="10"/>
                      </Button>
                    </Grid>
                    <ListView x:Name="Column3" Grid.Row="1" Tag="3" SelectionMode="None" CanDragItems="True" AllowDrop="True" ItemContainerStyle="{StaticResource Bare}" ItemTemplate="{StaticResource ReleaseCard}"
                              DragItemsStarting="BoardDragStarting" DragOver="BoardDragOver" Drop="BoardDrop" DragItemsCompleted="BoardDragCompleted">
                      <ListView.ItemContainerTransitions>
                        <TransitionCollection><AddDeleteThemeTransition/><RepositionThemeTransition/><EntranceThemeTransition IsStaggeringEnabled="True"/></TransitionCollection>
                      </ListView.ItemContainerTransitions>
                    </ListView>
                  </Grid>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Inner}" Padding="10,12">
                  <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="4,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource GoodBrush}"/>
                        <TextBlock Text="Live" FontSize="13" FontWeight="SemiBold"/>
                        <Border CornerRadius="9" Padding="7,1" Background="{ThemeResource InnerBrush}"><TextBlock Text="{Binding Count4}" FontSize="11"/></Border>
                      </StackPanel>
                      <Button Style="{StaticResource RoundInner}" Width="28" Height="28" HorizontalAlignment="Right" Tag="4" Click="ColumnAddClick" AutomationProperties.Name="Add to Live">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="10"/>
                      </Button>
                    </Grid>
                    <ListView x:Name="Column4" Grid.Row="1" Tag="4" SelectionMode="None" CanDragItems="True" AllowDrop="True" ItemContainerStyle="{StaticResource Bare}" ItemTemplate="{StaticResource ReleaseCard}"
                              DragItemsStarting="BoardDragStarting" DragOver="BoardDragOver" Drop="BoardDrop" DragItemsCompleted="BoardDragCompleted">
                      <ListView.ItemContainerTransitions>
