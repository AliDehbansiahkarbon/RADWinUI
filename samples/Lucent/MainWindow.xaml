              <ToggleButton x:Name="Filter0" Content="{Binding FilterText1}" Style="{StaticResource Chip}" Tag="0" Click="FilterClick"/>
              <ToggleButton x:Name="Filter1" Content="{Binding FilterText2}" Style="{StaticResource Chip}" Tag="1" Click="FilterClick"/>
              <ToggleButton x:Name="Filter2" Content="{Binding FilterText3}" Style="{StaticResource Chip}" Tag="2" Click="FilterClick"/>
              <ToggleButton x:Name="Filter3" Content="{Binding FilterText4}" Style="{StaticResource Chip}" Tag="3" Click="FilterClick"/>
              <ToggleButton x:Name="Filter4" Content="{Binding FilterText5}" Style="{StaticResource Chip}" Tag="4" Click="FilterClick"/>
              <ToggleButton x:Name="Filter5" Content="{Binding FilterText6}" Style="{StaticResource Chip}" Tag="5" Click="FilterClick"/>
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="20" Padding="3" Background="{ThemeResource InnerBrush}" BorderBrush="{ThemeResource InnerRimBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton x:Name="ViewBoard" Style="{StaticResource Chip}" IsChecked="True" Click="ViewClick" BorderThickness="0">
