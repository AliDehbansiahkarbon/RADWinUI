                    <ListView x:Name="Column1" Grid.Row="1" Tag="1" SelectionMode="None" CanDragItems="True" AllowDrop="True" ItemContainerStyle="{StaticResource Bare}" ItemTemplate="{StaticResource ReleaseCard}"
