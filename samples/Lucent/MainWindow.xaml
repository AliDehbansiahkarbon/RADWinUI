                        <Grid Grid.Column="3"><Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{Binding O3}"/><TextBlock Text="{Binding C3}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Grid>
                        <Grid Grid.Column="4"><Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{Binding O4}"/><TextBlock Text="{Binding C4}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Grid>
                        <Grid Grid.Column="5"><Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{Binding O5}"/><TextBlock Text="{Binding C5}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Grid>
                        <Grid Grid.Column="6"><Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{Binding O6}"/><TextBlock Text="{Binding C6}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border x:Name="CancelCard" Grid.Column="1" Style="{StaticResource Glass}">
              <StackPanel Spacing="12">
                <Grid>
                  <TextBlock Text="Why they cancel" Style="{StaticResource CardTitle}"/>
                  <Border HorizontalAlignment="Right" CornerRadius="10" Padding="9,3" Background="{ThemeResource InnerBrush}">
                    <TextBlock Text="Last 30 days" FontSize="11"/>
                  </Border>
                </Grid>
                <ItemsControl x:Name="CancelList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="TBar">
                      <StackPanel Spacing="6" Margin="0,6">
                        <Grid>
                          <TextBlock Text="{Binding Name}" FontSize="13"/>
                          <TextBlock Text="{Binding ValueText}" FontSize="13" HorizontalAlignment="Right" Foreground="{ThemeResource MutedBrush}"/>
                        </Grid>
                        <Border Height="6" CornerRadius="3" Background="{ThemeResource InnerBrush}">
                          <Border Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding Size}" Background="{ThemeResource BadBrush}" Opacity="0.8"/>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- 6. Growth -->
      <ScrollViewer x:Name="PageGrowth" VerticalScrollBarVisibility="Auto" Padding="10,6,30,26" Visibility="Collapsed">
        <StackPanel Spacing="20">
          <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="GrTitle" VerticalAlignment="Bottom">
              <TextBlock Text="Store" Style="{StaticResource PageFirst}"/>
              <TextBlock Text="Growth" Style="{StaticResource PageSecond}"/>
            </StackPanel>
            <StackPanel x:Name="GrKpis" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
              <Border Style="{StaticResource Kpi}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Style="{StaticResource IconDisc}"><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7B3;" FontSize="16"/></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageViewsText}" d:Text="1,240,400" Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="store page views, 30 days" Style="{StaticResource Caption}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Kpi}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Style="{StaticResource IconDisc}"><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE9D2;" FontSize="16"/></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConversionText}" d:Text="16.5%" Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="page view to install" Style="{StaticResource Caption}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Kpi}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Style="{StaticResource IconDisc}"><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE909;" FontSize="16"/></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding RegionsText}" d:Text="64" Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="countries with installs" Style="{StaticResource Caption}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SourcesCard" Style="{StaticResource Glass}">
              <StackPanel Spacing="12">
                <StackPanel>
                  <TextBlock Text="Acquisition sources" Style="{StaticResource CardTitle}"/>
                  <TextBlock Text="Where installs came from, last 30 days" Style="{StaticResource Caption}"/>
                </StackPanel>
                <ItemsControl x:Name="SourceList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="TBar">
                      <Grid ColumnSpacing="14" Margin="0,7">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource InnerBrush}">
                          <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="{Binding Glyph}" FontSize="14"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                          <Grid>
                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                            <TextBlock Text="{Binding ValueText}" FontSize="13" HorizontalAlignment="Right"/>
                          </Grid>
                          <Border Height="6" CornerRadius="3" Background="{ThemeResource InnerBrush}">
                            <Border Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding Size}" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                          </Border>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border x:Name="FunnelCard" Grid.Column="1" Style="{StaticResource Glass}">
              <StackPanel Spacing="12">
                <StackPanel>
                  <TextBlock Text="Conversion funnel" Style="{StaticResource CardTitle}"/>
                  <TextBlock Text="From a store impression to a paying customer" Style="{StaticResource Caption}"/>
                </StackPanel>
                <ItemsControl x:Name="FunnelList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="TBar">
                      <Grid Margin="0,5" Height="46">
                        <Border CornerRadius="14" HorizontalAlignment="Center" Width="{Binding Size}">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                              <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="0"/>
                              <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="1"/>
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>
                        <Grid Padding="16,0">
                          <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding ValueText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
          <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="RegionsCard" Style="{StaticResource Glass}">
              <StackPanel Spacing="10">
                <TextBlock Text="Top regions" Style="{StaticResource CardTitle}"/>
                <ItemsControl x:Name="RegionList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="TBar">
                      <Grid ColumnSpacing="12" Margin="0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="40"/>
                          <ColumnDefinition Width="140"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="8" Padding="0,3" Background="{ThemeResource InnerBrush}">
                          <TextBlock Text="{Binding Glyph}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Height="6" CornerRadius="3" Background="{ThemeResource InnerBrush}" VerticalAlignment="Center">
                          <Border Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding Size}" Background="{ThemeResource TealBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="3" Text="{Binding ValueText}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border x:Name="CampaignCard" Grid.Column="1" Style="{StaticResource Glass}">
              <StackPanel Spacing="10">
                <TextBlock Text="Campaigns" Style="{StaticResource CardTitle}"/>
                <ItemsControl x:Name="CampaignList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="TListRow">
                      <Border Style="{StaticResource Inner}" Margin="0,0,0,10">
                        <StackPanel Spacing="8">
                          <Grid>
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="10" Padding="9,3" Background="{ThemeResource GoodSoftBrush}">
                              <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{ThemeResource GoodBrush}"/>
                            </Border>
                          </Grid>
                          <ProgressBar Value="{Binding Progress}" Maximum="100"/>
                          <TextBlock Text="{Binding Value}" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- 7. Payouts -->
      <ScrollViewer x:Name="PagePayouts" VerticalScrollBarVisibility="Auto" Padding="10,6,30,26" Visibility="Collapsed">
        <StackPanel Spacing="20">
          <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="PaTitle" VerticalAlignment="Bottom">
              <TextBlock Text="Your" Style="{StaticResource PageFirst}"/>
              <TextBlock Text="Payouts" Style="{StaticResource PageSecond}"/>
            </StackPanel>
            <StackPanel x:Name="PaKpis" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
              <Border Style="{StaticResource Kpi}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Style="{StaticResource IconDisc}"><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C7;" FontSize="16"/></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PendingText}" d:Text="$12,904" Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="pending, not yet payable" Style="{StaticResource Caption}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Kpi}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Style="{StaticResource IconDisc}"><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE9D9;" FontSize="16"/></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PaidYearText}" d:Text="$716,040" Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="paid out this year" Style="{StaticResource Caption}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="20">
              <Grid x:Name="NextPayoutCard" Height="300">
                <Border CornerRadius="28">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="{ThemeResource SystemAccentColorLight1}" Offset="0"/>
                      <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0.6"/>
                      <GradientStop Color="{ThemeResource SystemAccentColorDark2}" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Border CornerRadius="28" BorderBrush="#59FFFFFF" BorderThickness="1">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#33FFFFFF" Offset="0"/>
                      <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <Ellipse Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-120" Fill="#1AFFFFFF" Stroke="#40FFFFFF"/>
                <Grid Padding="26,24">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Next payout" FontSize="14" Foreground="#E6FFFFFF"/>
                    <TextBlock x:Name="NextPayoutLabel" Text="{Binding NextPayoutText}" d:Text="$74,218" FontSize="44" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="White"/>
                    <TextBlock Text="Sunday 15 November, to Northwind Bank ending 4821" FontSize="12" TextWrapping="Wrap" Foreground="#CCFFFFFF"/>
                  </StackPanel>
                  <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="64" Height="64">
                      <ProgressRing IsIndeterminate="False" Value="{Binding CycleProgress}" Maximum="100" Width="64" Height="64" Foreground="White" Background="#33FFFFFF"/>
                      <TextBlock Text="{Binding CycleDaysText}" d:Text="20 d" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="of the payment cycle" FontSize="12" Foreground="#E6FFFFFF"/>
                      <TextBlock Text="Payouts are sent 45 days after month end" FontSize="11" Foreground="#B3FFFFFF"/>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Grid>
              <Border x:Name="SplitCard" Style="{StaticResource Glass}">
                <StackPanel Spacing="10">
                  <TextBlock Text="October by app" Style="{StaticResource CardTitle}"/>
                  <ItemsControl x:Name="SplitList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="TStudioApp">
                        <Grid ColumnSpacing="12" Margin="0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Border Width="30" Height="30" CornerRadius="9" Background="{Binding Tint}">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="{Binding Glyph}" FontSize="13" Foreground="White"/>
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="5">
                            <Grid>
                              <TextBlock Text="{Binding Name}" FontSize="13"/>
                              <TextBlock Text="{Binding ProceedsText}" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="5" CornerRadius="2.5" Background="{ThemeResource InnerBrush}">
                              <Border Height="5" CornerRadius="2.5" HorizontalAlignment="Left" Width="{Binding ShareWidth}" Background="{Binding Tint}"/>
                            </Border>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="20">
            <Border x:Name="HistoryCard" Style="{StaticResource Glass}" VerticalAlignment="Top">
              <StackPanel Spacing="6">
                <Grid Margin="0,0,0,10">
                  <TextBlock Text="Payout history" Style="{StaticResource CardTitle}"/>
                  <Button x:Name="StatementButton" HorizontalAlignment="Right" CornerRadius="16" Padding="14,6" Click="StatementClick"
                          Background="{ThemeResource InnerBrush}" BorderBrush="{ThemeResource InnerRimBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE896;" FontSize="12"/>
                      <TextBlock Text="Statement" FontSize="12"/>
                    </StackPanel>
                  </Button>
                </Grid>
                <Grid Padding="0,0,0,8" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Month" Style="{StaticResource Caption}"/>
                  <TextBlock Grid.Column="1" Text="Units" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="2" Text="Gross" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="Store fee" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="4" Text="Net" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                </Grid>
                <ItemsControl x:Name="PayoutList">
                  <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True"/></TransitionCollection>
                  </ItemsControl.ItemContainerTransitions>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="TPayout">
                      <Grid Padding="0,12" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="1.4*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Month}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Units}" FontSize="13" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{Binding Gross}" FontSize="13" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{Binding Fees}" FontSize="13" HorizontalAlignment="Right" Foreground="{ThemeResource MutedBrush}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Net}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <Border Grid.Column="5" HorizontalAlignment="Right" CornerRadius="10" Padding="9,2" Background="{ThemeResource GoodSoftBrush}" Visibility="{Binding Paid, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Text="Paid" FontSize="11" Foreground="{ThemeResource GoodBrush}"/>
                        </Border>
                        <Border Grid.Column="5" HorizontalAlignment="Right" CornerRadius="10" Padding="9,2" Background="{ThemeResource WarnSoftBrush}" Visibility="{Binding Paid, Converter={StaticResource InverseBoolToVisibility}}">
                          <TextBlock Text="Scheduled" FontSize="11" Foreground="{ThemeResource WarnBrush}"/>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Grid x:Name="AccountRow" ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Glass}">
                <StackPanel Spacing="12">
                  <TextBlock Text="Payout account" Style="{StaticResource CardTitle}"/>
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="40" CornerRadius="9" Background="{ThemeResource AvatarBrush}">
                      <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE825;" FontSize="18" Foreground="{ThemeResource AvatarTextBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Northwind Bank" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Business account ending 4821, US dollars" Style="{StaticResource Caption}"/>
                    </StackPanel>
                  </Grid>
                  <ToggleSwitch x:Name="InstantSwitch" Header="Send payouts as soon as they clear" IsOn="True"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Glass}">
                <StackPanel Spacing="10">
                  <TextBlock Text="Tax and compliance" Style="{StaticResource CardTitle}"/>
                  <Grid>
                    <TextBlock Text="W-8BEN tax form" FontSize="13"/>
                    <Border HorizontalAlignment="Right" CornerRadius="10" Padding="9,2" Background="{ThemeResource GoodSoftBrush}">
                      <TextBlock Text="Valid until 2028" FontSize="11" Foreground="{ThemeResource GoodBrush}"/>
                    </Border>
                  </Grid>
                  <Grid>
                    <TextBlock Text="VAT registration" FontSize="13"/>
                    <Border HorizontalAlignment="Right" CornerRadius="10" Padding="9,2" Background="{ThemeResource GoodSoftBrush}">
                      <TextBlock Text="Verified" FontSize="11" Foreground="{ThemeResource GoodBrush}"/>
                    </Border>
                  </Grid>
                  <Grid>
                    <TextBlock Text="Store agreement" FontSize="13"/>
                    <Border HorizontalAlignment="Right" CornerRadius="10" Padding="9,2" Background="{ThemeResource WarnSoftBrush}">
                      <TextBlock Text="Renew in 21 days" FontSize="11" Foreground="{ThemeResource WarnBrush}"/>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- 8. Team -->
      <ScrollViewer x:Name="PageTeam" VerticalScrollBarVisibility="Auto" Padding="10,6,30,26" Visibility="Collapsed">
        <StackPanel Spacing="20">
          <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="TeTitle" VerticalAlignment="Bottom">
              <TextBlock Text="Your" Style="{StaticResource PageFirst}"/>
              <TextBlock Text="Team" Style="{StaticResource PageSecond}"/>
            </StackPanel>
            <StackPanel x:Name="TeKpis" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
              <Border Style="{StaticResource Kpi}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Style="{StaticResource IconDisc}"><FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE716;" FontSize="16"/></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="MembersLabel" Text="{Binding MembersText}" d:Text="8" Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="members" Style="{StaticResource Caption}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Kpi}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Style="{StaticResource IconDisc}"><Ellipse Width="12" Height="12" Fill="{ThemeResource GoodBrush}"/></Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding OnlineText}" d:Text="5" Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="online now" Style="{StaticResource Caption}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Grid VerticalAlignment="Center">
                <Border CornerRadius="24" Margin="-6" Opacity="0.55">
                  <Border.Background>
                    <RadialGradientBrush>
                      <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0"/>
                      <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                  </Border.Background>
                </Border>
                <Button x:Name="InviteButton" Style="{StaticResource Accent}" Click="InviteClick">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8FA;" FontSize="12"/>
                    <TextBlock Text="Invite"/>
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Grid>
          <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            <GridView x:Name="TeamGrid" SelectionMode="None" ItemContainerStyle="{StaticResource BareGrid}">
              <GridView.ItemContainerTransitions>
                <TransitionCollection>
                  <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="50"/>
