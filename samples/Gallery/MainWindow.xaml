<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TMainWindow" DataContextType="TMainViewModel"
    Title="RADWinUI Gallery" Width="1180" Height="840" MinWidth="900" MinHeight="640"
    WindowStartupLocation="CenterScreen" Backdrop="Mica" ExtendsContentIntoTitleBar="True">
  <Grid x:Name="Surface" Background="Transparent" RequestedTheme="Default">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="32"/>
    </Grid.RowDefinitions>
    <Border x:Name="SolidLayer" Grid.RowSpan="3" Visibility="Collapsed"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>
    <Grid ColumnSpacing="24" Margin="20,0,148,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
      <Grid x:Name="DragRegion" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <FontIcon Glyph="&#xE8D4;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18"
                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
          <TextBlock Text="RADWinUI Gallery" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Padding="8,3" CornerRadius="5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock Text="DELPHI + WINUI 3" FontSize="9" CharacterSpacing="80"/>
          </Border>
        </StackPanel>
      </Grid>
      <ToggleSwitch x:Name="TransparencySwitch" OnContent="Transparency" OffContent="Transparency" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Transparency" Grid.Column="1"/>
      <ComboBox x:Name="ThemeChoice" Grid.Column="2" SelectedIndex="0" VerticalAlignment="Center"
                HorizontalAlignment="Stretch" SelectionChanged="ThemeChanged" AutomationProperties.Name="Appearance">
        <ComboBoxItem Content="Windows theme"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/>
      </ComboBox>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneTitle="Explore" OpenPaneLength="240"
                    IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Auto"
                    SelectionChanged="NavigationChanged" Background="Transparent">
      <NavigationView.AutoSuggestBox>
        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Find a control or demo"
                        QueryIcon="Find" TextChanged="SearchChanged" QuerySubmitted="SearchSubmitted"
                        SuggestionChosen="SearchSuggestionChosen" AutomationProperties.Name="Search demos"/>
      </NavigationView.AutoSuggestBox>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="NavHome" Content="Overview" Tag="0" Icon="Home"/>
        <NavigationViewItem x:Name="NavExplorer" Content="Control explorer" Tag="8" Icon="AllApps"/>
        <NavigationViewItemSeparator/>
        <NavigationViewItemHeader Content="CONTROL DEMOS"/>
        <NavigationViewItem x:Name="NavInputs" Content="Basic input" Tag="1" Icon="Edit"/>
        <NavigationViewItem x:Name="NavCollections" Content="Lists and collections" Tag="2" Icon="List"/>
        <NavigationViewItem x:Name="NavDates" Content="Date and time" Tag="3" Icon="Calendar"/>
        <NavigationViewItem x:Name="NavFeedback" Content="Feedback and dialogs" Tag="4" Icon="Message"/>
        <NavigationViewItem x:Name="NavLayout" Content="Layout and navigation" Tag="5" Icon="AllApps"/>
        <NavigationViewItem x:Name="NavMaterials" Content="Materials and color" Tag="6" Icon="Highlight"/>
        <NavigationViewItemSeparator/>
        <NavigationViewItemHeader Content="MADE WITH DELPHI"/>
        <NavigationViewItem x:Name="NavBinding" Content="Live Pascal binding" Tag="7" Icon="Sync"/>
      </NavigationView.MenuItems>
      <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Margin="28,20,28,32" MaxWidth="1120" HorizontalAlignment="Stretch">
          <StackPanel Spacing="6">
            <TextBlock x:Name="PageTitle" Text="A native canvas for your ideas" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="PageDescription" Text="Explore real Windows controls, backed by Object Pascal."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel x:Name="HomePage" Spacing="24">
            <Border CornerRadius="16" Padding="32">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{ThemeResource SystemAccentColorDark2}" Offset="0"/>
                <GradientStop Color="{ThemeResource SystemAccentColorDark3}" Offset="1"/>
              </LinearGradientBrush></Border.Background>
              <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="16">
                  <TextBlock Text="NATIVE WINDOWS. FAMILIAR DELPHI." Foreground="White" Opacity="0.85" FontSize="10" CharacterSpacing="140"/>
                  <TextBlock Text="Build native.&#xA;Think Delphi." FontSize="42" FontWeight="SemiBold" Foreground="White"/>
                  <TextBlock Text="WinUI 3 controls and materials. XAML layouts. Pascal events and live binding."
                             TextWrapping="Wrap" Foreground="White" Opacity="0.9" MaxWidth="520" HorizontalAlignment="Left"/>
                  <Button Content="Explore 30 controls" Tag="8" Click="CategoryClick" Padding="16,10"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="28" BorderBrush="#55FFFFFF" BorderThickness="1"
                        Background="#18FFFFFF" Width="140" Height="140" VerticalAlignment="Center">
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{}{ }" Foreground="White" FontFamily="Cascadia Code" FontSize="52" HorizontalAlignment="Center"/>
                    <TextBlock Text="OBJECT PASCAL" Foreground="White" FontSize="9" CharacterSpacing="100" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <StackPanel Spacing="6">
              <TextBlock Text="Find your next building block" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="30 individual controls. Seven guided demos. Source you can take with you."
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid ColumnSpacing="12" RowSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <Button Tag="1" Click="CategoryClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20" CornerRadius="12">
                <StackPanel Spacing="8"><FontIcon Glyph="&#xE70F;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                  <TextBlock Text="Basic input" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Buttons, text, switches and value controls." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              </Button>
              <Button Grid.Column="1" Tag="2" Click="CategoryClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20" CornerRadius="12">
                <StackPanel Spacing="8"><FontIcon Glyph="&#xE8FD;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                  <TextBlock Text="Lists and collections" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Build a collection and explore a hierarchy." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              </Button>
              <Button Grid.Row="1" Tag="3" Click="CategoryClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20" CornerRadius="12">
                <StackPanel Spacing="8"><FontIcon Glyph="&#xE787;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                  <TextBlock Text="Date and time" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Native calendars and date/time pickers." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              </Button>
              <Button Grid.Row="1" Grid.Column="1" Tag="4" Click="CategoryClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20" CornerRadius="12">
                <StackPanel Spacing="8"><FontIcon Glyph="&#xE946;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                  <TextBlock Text="Feedback and dialogs" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Info bars, progress and native modal dialogs." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              </Button>
              <Button Grid.Row="2" Tag="5" Click="CategoryClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20" CornerRadius="12">
                <StackPanel Spacing="8"><FontIcon Glyph="&#xE8A9;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                  <TextBlock Text="Layout and navigation" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Grids, tabs and expandable content." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              </Button>
              <Button Grid.Row="2" Grid.Column="1" Tag="6" Click="CategoryClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20" CornerRadius="12">
                <StackPanel Spacing="8"><FontIcon Glyph="&#xE790;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                  <TextBlock Text="Materials and color" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Mica, Acrylic and a live color playground." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              </Button>
              <Button Grid.Row="3" Grid.ColumnSpan="2" Tag="7" Click="CategoryClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20" CornerRadius="12">
                <StackPanel Spacing="8"><TextBlock Text="Live Pascal binding" FontWeight="SemiBold" FontSize="16"/>
                  <TextBlock Text="Edit a name, click a button, and watch published Delphi properties update the UI." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
              </Button>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="InputsPage" Spacing="16" Visibility="Collapsed">
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="18">
                <TextBlock Text="Make it personal" FontSize="20" FontWeight="SemiBold"/>
                <TextBox x:Name="NameEntry" Header="Your name" PlaceholderText="Type a name" MaxWidth="420" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Say hello" Click="GreetClick" Style="{StaticResource AccentButtonStyle}"/><CheckBox Content="Remember this device" IsChecked="True"/></StackPanel>
                <TextBlock x:Name="GreetingText" Text="A Pascal event is ready for your click." TextWrapping="Wrap"/>
                <ToggleSwitch x:Name="DemoSwitch" Header="Notifications" OnContent="Enabled" OffContent="Quiet mode" IsOn="True"/>
                <StackPanel Orientation="Horizontal" Spacing="18"><RadioButton Content="Comfortable" GroupName="Density" IsChecked="True"/><RadioButton Content="Compact" GroupName="Density"/></StackPanel>
              </StackPanel>
            </Border>
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="16">
                <TextBlock Text="Values and choices" FontSize="20" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <NumberBox Header="Quantity" Value="42" SpinButtonPlacementMode="Inline" Minimum="0" Maximum="100"/>
                  <ComboBox Grid.Column="1" Header="Preset" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Focused"/><ComboBoxItem Content="Expressive"/></ComboBox>
                </Grid>
                <TextBlock x:Name="VolumeText" Text="Intensity: 64%"/>
                <Slider x:Name="IntensitySlider" Minimum="0" Maximum="100" Value="64" ValueChanged="IntensityChanged" AutomationProperties.Name="Intensity"/>
                <ProgressBar x:Name="IntensityProgress" Minimum="0" Maximum="100" Value="64"/>
                <RatingControl Caption="How does it feel?" Value="4" MaxRating="5"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="CollectionsPage" Spacing="16" Visibility="Collapsed">
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="16">
                <TextBlock Text="A collection owned by Delphi" FontSize="20" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="NewItemText" PlaceholderText="Add your next idea" AutomationProperties.Name="New list item"/>
                  <Button Grid.Column="1" Content="Add" Click="AddItemClick"/>
                  <Button Grid.Column="2" Content="Remove selected" Click="RemoveItemClick"/>
                </Grid>
                <ListView x:Name="DemoList" SelectionMode="Single" SelectionChanged="ListChanged" Height="180"/>
                <TextBlock x:Name="SelectionText" Text="Choose an item to inspect the selection." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Border>
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="16"><TextBlock Text="A native hierarchy" FontSize="20" FontWeight="SemiBold"/>
                <TreeView Height="180"><TreeView.RootNodes>
                  <TreeViewNode Content="RADWinUI application" IsExpanded="True"><TreeViewNode.Children>
                    <TreeViewNode Content="MainWindow.xaml"/><TreeViewNode Content="MainWindow.pas"/>
                    <TreeViewNode Content="Framework" IsExpanded="True"><TreeViewNode.Children><TreeViewNode Content="Native WinUI controls"/><TreeViewNode Content="Pascal events and binding"/></TreeViewNode.Children></TreeViewNode>
                  </TreeViewNode.Children></TreeViewNode>
                </TreeView.RootNodes></TreeView>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="DatesPage" Spacing="16" Visibility="Collapsed">
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="20"><TextBlock Text="Choose a moment" FontSize="20" FontWeight="SemiBold"/>
                <CalendarDatePicker Header="A date, with a calendar flyout" PlaceholderText="Choose a date"/>
                <DatePicker Header="Date picker"/><TimePicker Header="Time picker"/>
              </StackPanel>
            </Border>
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="16"><TextBlock Text="The calendar, inline" FontSize="20" FontWeight="SemiBold"/>
                <CalendarView SelectionMode="Single" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="FeedbackPage" Spacing="16" Visibility="Collapsed">
            <InfoBar x:Name="FeedbackBar" IsOpen="True" IsClosable="True" Title="Ready to explore" Message="These are native WinUI controls with Pascal handlers." Severity="Informational"/>
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="20"><TextBlock Text="Clear feedback, familiar behavior" FontSize="20" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Success" Tag="success" Click="FeedbackClick"/><Button Content="Warning" Tag="warning" Click="FeedbackClick"/><Button Content="Open dialog" Click="DialogClick"/></StackPanel>
                <ToggleSwitch x:Name="ActivitySwitch" Header="Background activity" IsOn="True" Toggled="ActivityChanged"/>
                <StackPanel Orientation="Horizontal" Spacing="16"><ProgressRing x:Name="ActivityRing" IsActive="True" Width="32" Height="32"/><TextBlock Text="A Windows animation, no custom drawing loop." VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                <ProgressBar x:Name="ActivityProgress" IsIndeterminate="True"/>
                <Button Content="Open a native flyout"><Button.Flyout><Flyout><StackPanel Spacing="12"><TextBlock Text="Content in a native flyout" FontWeight="SemiBold"/><ToggleSwitch Header="An option" IsOn="True"/></StackPanel></Flyout></Button.Flyout></Button>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="LayoutPage" Spacing="16" Visibility="Collapsed">
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="18"><TextBlock Text="Layout comes from XAML" FontSize="20" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="10" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="64"/></Grid.RowDefinitions>
                  <Border CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}"><TextBlock Text="2*" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/></Border>
                  <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardStrokeColorDefaultBrush}"><TextBlock Text="*" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/></Border>
                  <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="8" Background="{ThemeResource CardStrokeColorDefaultBrush}"><TextBlock Text="ColumnSpan = 2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                </Grid>
                <Expander Header="Expand for a layout tip" HorizontalAlignment="Stretch"><TextBlock Text="Use Grid for rows, columns and remaining space. Use StackPanel for a flowing sequence. The designer writes ordinary XAML." TextWrapping="Wrap"/></Expander>
              </StackPanel>
            </Border>
            <TabView IsAddTabButtonVisible="False" Height="200">
              <TabViewItem Header="Overview" IsClosable="False"><Border Padding="24"><TextBlock Text="A real WinUI TabView. Switch tabs with the mouse or keyboard." TextWrapping="Wrap"/></Border></TabViewItem>
              <TabViewItem Header="Details" IsClosable="False"><Border Padding="24"><StackPanel Spacing="10"><TextBlock Text="Keep navigation native." FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Tab focus, selected state and theme resources come from WinUI." TextWrapping="Wrap"/></StackPanel></Border></TabViewItem>
            </TabView>
          </StackPanel>

          <StackPanel x:Name="MaterialsPage" Spacing="16" Visibility="Collapsed">
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="16"><TextBlock Text="Windows materials, on your desktop" FontSize="20" FontWeight="SemiBold"/>
                <ComboBox x:Name="BackdropChoice" Header="Window backdrop" SelectedIndex="0" SelectionChanged="BackdropChanged" MinWidth="240"><ComboBoxItem Content="Mica"/><ComboBoxItem Content="Mica Alt"/><ComboBoxItem Content="Desktop Acrylic"/><ComboBoxItem Content="Solid surface"/></ComboBox>
                <TextBlock Text="The title bar and navigation surface expose the backdrop. Windows can use a solid fallback when inactive, or because of transparency, power or accessibility settings." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Border>
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="16"><TextBlock Text="A live color playground" FontSize="20" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ColorPicker x:Name="DemoColorPicker" Color="#FF206DCA" IsAlphaEnabled="True" IsMoreButtonVisible="False" Width="300" ColorChanged="ColorChanged"/>
                  <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center"><Border x:Name="ColorSwatch" Height="140" CornerRadius="16" Background="#FF206DCA"/>
                    <TextBlock x:Name="ColorValue" Text="#FF206DCA" FontFamily="Cascadia Code" FontSize="18"/>
                    <TextBlock Text="A ColorChanged event updates a Delphi-owned brush." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="BindingPage" Spacing="16" Visibility="Collapsed">
            <Border Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Spacing="20"><TextBlock Text="Published properties. Live UI." FontSize="20" FontWeight="SemiBold"/>
                <TextBox Header="A two-way bound Delphi string" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding Summary}" d:Text="Hello, Delphi developer. Pascal has received 0 clicks." TextWrapping="Wrap" FontSize="20"/>
                <StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Increment" Click="IncrementClick" Style="{StaticResource AccentButtonStyle}"/><Button Content="Reset" Click="ResetClick"/>
                  <TextBlock Text="{Binding Count}" d:Text="0" FontSize="30" VerticalAlignment="Center"/>
                </StackPanel>
                <ProgressBar Value="{Binding Count}" Maximum="100"/>
                <TextBlock Text="No polling of the model. Changed('Name') and Changed('Count') notify the native bindings. The clock in the footer is another published property." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <Grid x:Name="ExplorerPage" Visibility="Collapsed" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="10">
              <TextBox x:Name="ExplorerFilter" PlaceholderText="Filter controls" TextChanged="ExplorerFilterChanged" AutomationProperties.Name="Filter controls"/>
              <TextBlock x:Name="ExplorerCount" Text="30 controls" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <ListView x:Name="ExplorerList" Height="440" SelectionChanged="ExplorerSelectionChanged" AutomationProperties.Name="Control catalog"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="16">
              <StackPanel Spacing="5">
                <TextBlock x:Name="ControlTitle" Text="Button" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="ControlCategory" Text="Basic input" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                <TextBlock x:Name="ControlDescription" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                  <TextBlock Text="LIVE SAMPLE" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  <StackPanel x:Name="ExplorerSamples" MinHeight="140">
                    <StackPanel Tag="Button" Visibility="Collapsed" HorizontalAlignment="Stretch"><Button x:Name="SampleButton" Content="Click me" Click="ExplorerButtonClick" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
                    <StackPanel Tag="ToggleButton" Visibility="Collapsed" HorizontalAlignment="Stretch"><ToggleButton x:Name="SampleToggleButton" Content="Keep this selected"/></StackPanel>
                    <StackPanel Tag="RepeatButton" Visibility="Collapsed" HorizontalAlignment="Stretch"><RepeatButton x:Name="SampleRepeatButton" Content="Press and hold" Click="ExplorerButtonClick" Delay="400" Interval="100"/></StackPanel>
                    <StackPanel Tag="SplitButton" Visibility="Collapsed" HorizontalAlignment="Stretch"><SplitButton x:Name="SampleSplitButton" Content="Export"><SplitButton.Flyout><MenuFlyout><MenuFlyoutItem Text="As image"/><MenuFlyoutItem Text="As document"/></MenuFlyout></SplitButton.Flyout></SplitButton></StackPanel>
                    <StackPanel Tag="HyperlinkButton" Visibility="Collapsed" HorizontalAlignment="Stretch"><HyperlinkButton x:Name="SampleHyperlinkButton" Content="A native hyperlink" Click="ExplorerButtonClick"/></StackPanel>
                    <StackPanel Tag="TextBox" Visibility="Collapsed" HorizontalAlignment="Stretch"><TextBox x:Name="SampleTextBox" Header="Your idea" PlaceholderText="Type something" Text="Made with Delphi"/></StackPanel>
                    <StackPanel Tag="PasswordBox" Visibility="Collapsed" HorizontalAlignment="Stretch"><PasswordBox x:Name="SamplePasswordBox" Header="Sample password" PlaceholderText="Enter a sample password"/></StackPanel>
                    <StackPanel Tag="RichEditBox" Visibility="Collapsed" HorizontalAlignment="Stretch"><RichEditBox x:Name="SampleRichEditBox" Header="A richer canvas" Height="120" PlaceholderText="Write, select text, then open the editing menu"/></StackPanel>
                    <StackPanel Tag="NumberBox" Visibility="Collapsed" HorizontalAlignment="Stretch"><NumberBox x:Name="SampleNumberBox" Header="Quantity" Value="12" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline"/></StackPanel>
                    <StackPanel Tag="Slider" Visibility="Collapsed" HorizontalAlignment="Stretch"><Slider x:Name="SampleSlider" Minimum="0" Maximum="100" Value="64" StepFrequency="1" AutomationProperties.Name="Sample intensity"/></StackPanel>
                    <StackPanel Tag="ToggleSwitch" Visibility="Collapsed" HorizontalAlignment="Stretch"><ToggleSwitch x:Name="SampleToggleSwitch" Header="Notifications" OnContent="Enabled" OffContent="Disabled" IsOn="True"/></StackPanel>
                    <StackPanel Tag="CheckBox" Visibility="Collapsed" HorizontalAlignment="Stretch"><CheckBox x:Name="SampleCheckBox" Content="Include subfolders" IsThreeState="True"/></StackPanel>
                    <StackPanel Tag="RadioButtons" Visibility="Collapsed" HorizontalAlignment="Stretch"><RadioButtons x:Name="SampleRadioButtons" Header="Density" SelectedIndex="0"><RadioButton Content="Comfortable"/><RadioButton Content="Compact"/></RadioButtons></StackPanel>
                    <StackPanel Tag="ComboBox" Visibility="Collapsed" HorizontalAlignment="Stretch"><ComboBox x:Name="SampleComboBox" Header="Workspace" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="Design"/><ComboBoxItem Content="Code"/><ComboBoxItem Content="Explore"/></ComboBox></StackPanel>
                    <StackPanel Tag="ListBox" Visibility="Collapsed" HorizontalAlignment="Stretch"><ListBox x:Name="SampleListBox" SelectedIndex="0"><ListBoxItem Content="Create a window"/><ListBoxItem Content="Drop a control"/><ListBoxItem Content="Write Pascal"/></ListBox></StackPanel>
                    <StackPanel Tag="GridView" Visibility="Collapsed" HorizontalAlignment="Stretch"><GridView x:Name="SampleGridView" SelectionMode="Single" Height="160"><GridViewItem><Border Background="{ThemeResource AccentFillColorDefaultBrush}" Padding="20"><TextBlock Text="Design"/></Border></GridViewItem><GridViewItem><Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="20"><TextBlock Text="Code"/></Border></GridViewItem></GridView></StackPanel>
                    <StackPanel Tag="Expander" Visibility="Collapsed" HorizontalAlignment="Stretch"><Expander x:Name="SampleExpander" Header="Details" HorizontalAlignment="Stretch"><TextBlock Text="Native controls. Object Pascal events." TextWrapping="Wrap"/></Expander></StackPanel>
                    <StackPanel Tag="TabView" Visibility="Collapsed" HorizontalAlignment="Stretch"><TabView x:Name="SampleTabView" IsAddTabButtonVisible="False" Height="170"><TabViewItem Header="Design" IsClosable="False"><TextBlock Text="Your XAML surface" Margin="12"/></TabViewItem><TabViewItem Header="Code" IsClosable="False"><TextBlock Text="Your Object Pascal" Margin="12"/></TabViewItem></TabView></StackPanel>
                    <StackPanel Tag="CalendarDatePicker" Visibility="Collapsed" HorizontalAlignment="Stretch"><CalendarDatePicker x:Name="SampleCalendarDatePicker" Header="Start date" PlaceholderText="Choose a date"/></StackPanel>
                    <StackPanel Tag="DatePicker" Visibility="Collapsed" HorizontalAlignment="Stretch"><DatePicker x:Name="SampleDatePicker" Header="Date"/></StackPanel>
                    <StackPanel Tag="TimePicker" Visibility="Collapsed" HorizontalAlignment="Stretch"><TimePicker x:Name="SampleTimePicker" Header="Reminder" MinuteIncrement="5"/></StackPanel>
                    <StackPanel Tag="ProgressBar" Visibility="Collapsed" HorizontalAlignment="Stretch"><ProgressBar x:Name="SampleProgressBar" Minimum="0" Maximum="100" Value="65" AutomationProperties.Name="Sample progress"/></StackPanel>
                    <StackPanel Tag="ProgressRing" Visibility="Collapsed" HorizontalAlignment="Stretch"><ProgressRing x:Name="SampleProgressRing" IsActive="True" Width="48" Height="48" HorizontalAlignment="Left" AutomationProperties.Name="Working"/></StackPanel>
                    <StackPanel Tag="RatingControl" Visibility="Collapsed" HorizontalAlignment="Stretch"><RatingControl x:Name="SampleRatingControl" Caption="Rate this idea" Value="4" MaxRating="5"/></StackPanel>
                    <StackPanel Tag="ColorPicker" Visibility="Collapsed" HorizontalAlignment="Stretch"><ColorPicker x:Name="SampleColorPicker" Color="#FF0078D4" IsAlphaEnabled="True"/></StackPanel>
                    <StackPanel Tag="InfoBar" Visibility="Collapsed" HorizontalAlignment="Stretch"><InfoBar x:Name="SampleInfoBar" IsOpen="True" Severity="Success" Title="Ready" Message="Built with Delphi and WinUI 3." IsClosable="False"/></StackPanel>
                    <StackPanel Tag="MenuBar" Visibility="Collapsed" HorizontalAlignment="Stretch"><MenuBar x:Name="SampleMenuBar"><MenuBarItem Title="File"><MenuFlyoutItem Text="New"/><MenuFlyoutItem Text="Open"/></MenuBarItem><MenuBarItem Title="Help"><MenuFlyoutItem Text="About"/></MenuBarItem></MenuBar></StackPanel>
                    <StackPanel Tag="CommandBar" Visibility="Collapsed" HorizontalAlignment="Stretch"><CommandBar x:Name="SampleCommandBar" DefaultLabelPosition="Bottom"><AppBarButton Icon="Save" Label="Save"/><AppBarButton Icon="Edit" Label="Edit"/><CommandBar.SecondaryCommands><AppBarButton Label="More options"/></CommandBar.SecondaryCommands></CommandBar></StackPanel>
                    <StackPanel Tag="PersonPicture" Visibility="Collapsed" HorizontalAlignment="Stretch"><PersonPicture x:Name="SamplePersonPicture" DisplayName="Delphi Developer" Width="88" Height="88" HorizontalAlignment="Left"/></StackPanel>
                    <StackPanel Tag="TextBlock" Visibility="Collapsed" HorizontalAlignment="Stretch"><TextBlock x:Name="SampleTextBlock" Text="A native canvas for your ideas." FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Expander Header="Try the layout" HorizontalAlignment="Stretch" IsExpanded="True">
                <StackPanel Spacing="12">
                  <ToggleSwitch x:Name="ExplorerEnabled" Header="Enabled" IsOn="True" Toggled="ExplorerOptionsChanged"/>
                  <ComboBox x:Name="ExplorerFlow" Header="Reading direction" SelectedIndex="0" SelectionChanged="ExplorerFlowChanged" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Left to right"/><ComboBoxItem Content="Right to left"/>
                  </ComboBox>
                  <Button Content="Read current value in Pascal" Click="ExplorerValueClick"/>
                  <TextBlock x:Name="ExplorerValue" Text="Choose a control, interact with it, then read its value." TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Grid>

          <Expander x:Name="SourcePanel" Header="View XAML and Pascal" HorizontalAlignment="Stretch" Visibility="Collapsed">
            <StackPanel Spacing="16">
              <Grid><TextBlock Text="XAML" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Copy XAML" Click="CopyXamlClick" HorizontalAlignment="Right"/></Grid>
              <TextBox x:Name="XamlSource" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Code" FontSize="12" Height="150" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="XAML example"/>
              <Grid><TextBlock Text="OBJECT PASCAL" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="Copy Pascal" Click="CopyPascalClick" HorizontalAlignment="Right"/></Grid>
              <TextBox x:Name="PascalSource" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Code" FontSize="12" Height="180" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Pascal example"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </NavigationView>
    <Grid Grid.Row="2" Margin="20,0" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Native WinUI 3. Object Pascal. Made with RADWinUI." FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock Grid.Column="1" Text="{Binding Clock}" d:Text="Mon, 19 Oct 2026  19:30:00" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
  </Grid>
</Window>
