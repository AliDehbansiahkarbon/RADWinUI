<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The current order of the Ember_VCL form, as a WinUI card. The form's
       TWinUIHost loads this file (XamlFile), binds it to a TOrderCard, and the
       two buttons call published methods of the form. It is in a subfolder
       because XamlCodeGen turns every .xaml next to the project into a unit.
       Edit it while the app runs in Debug: the card updates at once. -->
  <!-- Ember's orange for the accent button -->
  <ScrollViewer.Resources>
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#E2572A"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#EC6A3C"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#C94A22"/>
    <SolidColorBrush x:Key="AccentButtonForeground" Color="White"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF"/>
  </ScrollViewer.Resources>
  <StackPanel Padding="28,24" Spacing="18" MaxWidth="460" HorizontalAlignment="Left">
    <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <PersonPicture DisplayName="{Binding Customer}" Width="56" Height="56"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding Customer}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding City}" Opacity="0.7"/>
      </StackPanel>
    </Grid>

    <Border CornerRadius="14" Padding="20,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid RowSpacing="12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding OrderNo}" FontSize="13" Opacity="0.7"/>
          <TextBlock Text="{Binding DateText}" FontWeight="SemiBold"/>
        </StackPanel>
        <Border Grid.Column="1" CornerRadius="12" Padding="12,4,12,5" Background="#26F0652B" VerticalAlignment="Top">
          <TextBlock Text="{Binding Status}" Foreground="#F0652B" FontWeight="SemiBold" FontSize="13"/>
        </Border>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
          <FontIcon Glyph="&#xEC32;" FontSize="22" Foreground="#F0652B"/>
          <StackPanel>
            <TextBlock FontWeight="SemiBold">
              <Run Text="{Binding Coffee}"/><Run Text=", "/><Run Text="{Binding Origin}"/>
            </TextBlock>
            <TextBlock Text="{Binding Notes}" FontSize="13" Opacity="0.7" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <TextBlock Text="Weight" FontSize="12" Opacity="0.7"/>
          <TextBlock Text="{Binding KgText}" FontSize="24" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Text="Total" FontSize="12" Opacity="0.7" HorizontalAlignment="Right"/>
          <TextBlock Text="{Binding TotalText}" FontSize="24" FontWeight="SemiBold" Foreground="#F0652B"/>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <FontIcon Glyph="&#xE77B;" FontSize="14" Opacity="0.7"/>
      <TextBlock Text="{Binding Contact}" Opacity="0.8"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button x:Name="RoastButton" Content="Start roasting" Click="StartRoastingClick" IsEnabled="{Binding CanRoast}"/>
      <Button x:Name="ShipButton" Content="Mark as shipped" Click="ShipClick" IsEnabled="{Binding CanShip}"
              Style="{StaticResource AccentButtonStyle}"/>
    </StackPanel>
  </StackPanel>
</ScrollViewer>
