<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TAddStationWindow"
    Title="Add station" Width="400" Height="300" Backdrop="MicaAlt"
    Resizable="False" Minimizable="False" Maximizable="False" WindowStartupLocation="CenterOwner">
  <!-- Shown with ShowModal: Tempo's main window is disabled until it closes -->
  <StackPanel Padding="24" Spacing="12">
    <TextBlock Text="Add a station" Style="{StaticResource SubtitleTextBlockStyle}"/>
    <TextBox x:Name="NameBox" Header="Name" PlaceholderText="Night Owl" TextChanged="NameChanged"
             AutomationProperties.Name="Station name"/>
    <ComboBox x:Name="GenreBox" Header="Genre" SelectedIndex="0" HorizontalAlignment="Stretch">
      <x:String>Chill</x:String>
      <x:String>Jazz</x:String>
      <x:String>Electronic</x:String>
      <x:String>Classical</x:String>
      <x:String>Rock</x:String>
    </ComboBox>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="AddButton" Content="Add" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
              Click="AddClick"/>
      <Button x:Name="CancelButton" Content="Cancel" Click="CancelClick"/>
    </StackPanel>
  </StackPanel>
</Window>