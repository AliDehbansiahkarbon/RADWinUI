<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rw="using:RADWinUI.Controls"
    x:Class="TMainWindow" Title="Advanced Components" Width="1280" Height="940" MinWidth="1060" MinHeight="720"
    WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" Backdrop="Transparent">
  <!-- RADWinUI's own advanced controls on one page: the Text Fields, Swipe
       Actions, Pagination and Progress Steps categories, plus the Tab Bars and
       Action Buttons. The bar at the top is a SlidingPillTabBar whose Pages
       property shows one section per tab, with no code. The page follows the
       Windows theme: every colour is a theme resource, and the controls pick
       their surfaces from the theme unless Background is set. MainWindow.pas
       adds the accent colours, the transparency and the status line. -->
  <Grid x:Name="Root" Background="Transparent">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBrush" Color="#F3F2F7"/>
            <SolidColorBrush x:Key="CardBrush" Color="#E6FFFFFF"/>
            <SolidColorBrush x:Key="CardEdgeBrush" Color="#14000000"/>
            <SolidColorBrush x:Key="StageBrush" Color="#F3F2F8"/>
            <SolidColorBrush x:Key="InkBrush" Color="#1B1829"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#5E5A72"/>
            <SolidColorBrush x:Key="FaintBrush" Color="#85819A"/>
            <SolidColorBrush x:Key="ChipBrush" Color="#ECEAF4"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceEdgeBrush" Color="#DEDBE9"/>
            <SolidColorBrush x:Key="SurfaceTextBrush" Color="#2A2640"/>
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#6F6B85"/>
            <SolidColorBrush x:Key="BarBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BarEdgeBrush" Color="#E2DFEC"/>
            <SolidColorBrush x:Key="BarIconBrush" Color="#8A86A0"/>
            <SolidColorBrush x:Key="SwatchEdgeBrush" Color="#D9D6E4"/>
            <Color x:Key="GlowColorA">#307C4DFF</Color>
            <Color x:Key="GlowColorB">#2AE14FB4</Color>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBrush" Color="#0E0D15"/>
            <SolidColorBrush x:Key="CardBrush" Color="#E615131F"/>
            <SolidColorBrush x:Key="CardEdgeBrush" Color="#25222F"/>
            <SolidColorBrush x:Key="StageBrush" Color="#100E17"/>
            <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#9A96B0"/>
            <SolidColorBrush x:Key="FaintBrush" Color="#77738C"/>
            <SolidColorBrush x:Key="ChipBrush" Color="#1F1C2C"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1829"/>
            <SolidColorBrush x:Key="SurfaceEdgeBrush" Color="#2E2A40"/>
            <SolidColorBrush x:Key="SurfaceTextBrush" Color="#D8D4EA"/>
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#A7A3BC"/>
            <SolidColorBrush x:Key="BarBrush" Color="#1D1A2C"/>
            <SolidColorBrush x:Key="BarEdgeBrush" Color="#2E2A40"/>
            <SolidColorBrush x:Key="BarIconBrush" Color="#8F8AA8"/>
            <SolidColorBrush x:Key="SwatchEdgeBrush" Color="#2E2A3D"/>
            <Color x:Key="GlowColorA">#487C4DFF</Color>
            <Color x:Key="GlowColorB">#36E14FB4</Color>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="Card" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
          <Setter Property="BorderBrush" Value="{ThemeResource CardEdgeBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="24"/>
          <Setter Property="Padding" Value="18,16,18,18"/>
        </Style>
        <Style x:Key="Stage" TargetType="Grid">
          <Setter Property="Background" Value="{ThemeResource StageBrush}"/>
          <Setter Property="CornerRadius" Value="16"/>
          <Setter Property="Height" Value="150"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
          <Setter Property="FontSize" Value="16"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
        </Style>
        <Style x:Key="CardClass" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
          <Setter Property="FontSize" Value="11.5"/>
          <Setter Property="Foreground" Value="{ThemeResource FaintBrush}"/>
        </Style>
        <Style x:Key="CardText" TargetType="TextBlock">
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource ChipBrush}"/>
          <Setter Property="CornerRadius" Value="11"/>
          <Setter Property="Padding" Value="10,3,10,4"/>
          <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
          <Setter Property="FontSize" Value="11.5"/>
          <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
          <Setter Property="FontSize" Value="11"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="CharacterSpacing" Value="80"/>
          <Setter Property="Foreground" Value="{ThemeResource FaintBrush}"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
          <Setter Property="Width" Value="30"/>
          <Setter Property="Height" Value="30"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="CornerRadius" Value="15"/>
          <Setter Property="BorderThickness" Value="2"/>
          <Setter Property="BorderBrush" Value="{ThemeResource SwatchEdgeBrush}"/>
        </Style>
      </ResourceDictionary>
    </Grid.Resources>

    <!-- The page itself. Its Opacity is the transparency slider: below 1 the desktop shows through -->
    <Border x:Name="Glass" Background="{ThemeResource PageBrush}" CornerRadius="8" Opacity="0.65"/>

    <!-- Two soft lights behind everything -->
    <Ellipse Width="820" Height="820" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-240,-320,0,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="{ThemeResource GlowColorA}" Offset="0"/>
          <GradientStop Color="#007C4DFF" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-280,-360" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="{ThemeResource GlowColorB}" Offset="0"/>
          <GradientStop Color="#00E14FB4" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <ScrollViewer>
      <Grid Padding="40,40,40,28" RowSpacing="22" MaxWidth="1300">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title and the settings for every control at once -->
        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="6" VerticalAlignment="Center">
            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource ChipText}" Text="RADWinUI  &#x00B7;  Tool Palette  &#x00B7;  38 controls in 6 categories"/>
            </Border>
            <TextBlock Text="Advanced Components" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}"/>
            <TextBlock Text="Text fields, swipe actions, pagers, progress steps, tab bars and action buttons. Drop one on a window, set it up in the Object Inspector and handle one event." FontSize="14" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,14,20,14" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="26">
              <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource Caption}" Text="ACCENT"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="OriginalSwatch" Style="{StaticResource Swatch}" Click="OriginalClick" ToolTipService.ToolTip="Each control's own colours" AutomationProperties.Name="Original">
                    <Ellipse Width="22" Height="22"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7C4DFF" Offset="0"/><GradientStop Color="#E14FB4" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
                  </Button>
                  <Button x:Name="SunsetSwatch" Style="{StaticResource Swatch}" Click="SunsetClick" ToolTipService.ToolTip="Sunset" AutomationProperties.Name="Sunset">
                    <Ellipse Width="22" Height="22"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF5F6D" Offset="0"/><GradientStop Color="#FFC371" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
                  </Button>
                  <Button x:Name="MintSwatch" Style="{StaticResource Swatch}" Click="MintClick" ToolTipService.ToolTip="Mint" AutomationProperties.Name="Mint">
                    <Ellipse Width="22" Height="22"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#11B98E" Offset="0"/><GradientStop Color="#7CF29A" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
                  </Button>
                  <Button x:Name="OceanSwatch" Style="{StaticResource Swatch}" Click="OceanClick" ToolTipService.ToolTip="Ocean" AutomationProperties.Name="Ocean">
                    <Ellipse Width="22" Height="22"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2B5CFF" Offset="0"/><GradientStop Color="#2BD9FF" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
                  </Button>
                </StackPanel>
              </StackPanel>
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Style="{StaticResource Caption}" Text="TRANSPARENCY"/>
                  <TextBlock x:Name="GlassText" Style="{StaticResource Caption}" Foreground="{ThemeResource MutedBrush}" Text="35%"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <ToggleSwitch x:Name="TransparencySwitch" OnContent="" OffContent="" MinWidth="0" IsOn="True"
                                Toggled="TransparencyToggled" AutomationProperties.Name="Transparency"/>
                  <Slider x:Name="GlassSlider" Width="110" Minimum="0" Maximum="90" StepFrequency="5" Value="35"
                          ValueChanged="GlassChanged" AutomationProperties.Name="Transparency level" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <!-- One section per tab: Pages shows the one of the selected tab -->
        <rw:SlidingPillTabBar x:Name="SectionBar" Grid.Row="1" Width="720" HorizontalAlignment="Center"
            AutomationProperties.Name="Sections"
            Background="{ThemeResource BarBrush}" BorderBrush="{ThemeResource BarEdgeBrush}" Foreground="{ThemeResource BarIconBrush}"
            Items="Fields:Edit, Swipe:Message, Pages:Document, Steps:Check, Tabs:Apps, Buttons:Like"
            Pages="FieldsPage, SwipePage, PaginationPage, StepsPage, TabBarsPage, ButtonsPage" SelectionChanged="SectionChanged"/>

      <!-- Text Fields -->
      <StackPanel x:Name="FieldsPage" Grid.Row="2" Spacing="16">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Text Fields" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}"/>
            <TextBlock Text="Six inputs that guide the typing. Each one is a real text box underneath: copy, paste and the keyboard work as usual." FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <Grid ColumnSpacing="20" RowSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="1  OTP Code"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIOtpCodeField"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:OtpCodeField x:Name="OtpField1" HorizontalAlignment="Center" VerticalAlignment="Center" CodeLength="4" AutoVerify="False"
                    Header="Enter the code we sent" Completed="OtpCompleted"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Type four digits: each box takes one and the caret moves on. Try 2468 for the mint wave, any other code shakes red."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="2  Card Number"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUICardNumberField"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:CardNumberField x:Name="CardField1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="290" Completed="CardCompleted"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="The digits group in fours as you type. With the number complete it folds to its last four and the expiry and CVC slide in."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="3  Strength Meter"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIStrengthMeterField"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:StrengthMeterField x:Name="StrengthField1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="290" TextChanged="StrengthChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Four segments fill and change colour as the password gets stronger: length, mixed case, digits and symbols."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="4  Auto Grow"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIAutoGrowField"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:AutoGrowField x:Name="GrowField1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Width="290"
                    PlaceholderText="Write a message..." Submitted="GrowSubmitted"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="The field grows a line at a time up to MaxLines. Ctrl+Enter or the send button raises Submitted."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="5  Tag Input"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUITagInputField"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:TagInputField x:Name="TagField1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="290" Tags="Delphi, WinUI" PlaceholderText="Add a topic"
                    TagsChanged="TagsChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Space, comma or Enter turns a word into a chip. Backspace twice or the x removes one."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="6  Ghost Complete"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIGhostCompleteField"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:GhostCompleteField x:Name="GhostField1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="290" PlaceholderText="name@"
                    Accepted="GhostAccepted"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Type a name and @: the rest of the address shows faintly. Tab or the right arrow takes it."/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <!-- Swipe Actions -->
      <StackPanel x:Name="SwipePage" Grid.Row="2" Spacing="16" Visibility="Collapsed">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Swipe Actions" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}"/>
            <TextBlock Text="Drag a row or a card with the mouse, a pen or a finger. With the keyboard, Up and Down choose a row and Left or Right swipes it." FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Column="1" x:Name="RefillButton" Content="Bring the rows back" Click="RefillClick" CornerRadius="15" Height="30" VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnSpacing="20" RowSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="1  Card Swipe"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUISwipeCardStack"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="230">
                <rw:SwipeCardStack x:Name="CardStack1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Liked="CardLiked" Passed="CardPassed"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Drag the top card: it tilts and a LIKE or NOPE stamp fades in. Let go far enough and it flies off, the next card rises."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="2  Swipe to Pin"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIPinSwipeList"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="230">
                <rw:PinSwipeList x:Name="PinList1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="290" Pinned="RowPinned" Unpinned="RowUnpinned"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Swipe a row to the right: the pin pops on and the row jumps to the top. Swipe it again to unpin."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="3  Peek Hint"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIPeekSwipeList"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="230">
                <rw:PeekSwipeList x:Name="PeekList1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="290" Deleted="RowDeleted"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A row peeks to the left now and then, to show there is more behind it. Swipe it open and tap Delete."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="4  Liquid Delete"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUILiquidDeleteList"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="230">
                <rw:LiquidDeleteList x:Name="LiquidList1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="290" Deleted="RowDeleted"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Swipe left: a red blob stretches out of the row, snaps off and pops, and the row goes with it."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="5  Snooze Clock"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUISnoozeSwipeList"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="230">
                <rw:SnoozeSwipeList x:Name="SnoozeList1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="290" Snoozed="RowSnoozed"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Swipe left to snooze. The clock spins as you drag and the time steps from 1h to 3h to 6 PM."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="6  Inline Undo"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIUndoSwipeList"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="230">
                <rw:UndoSwipeList x:Name="UndoList1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="290" Deleted="RowDeleted" Restored="RowRestored"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Swipe a row away and an Undo strip stays for a moment. Undo slides the row back in."/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <!-- Pagination -->
      <StackPanel x:Name="PaginationPage" Grid.Row="2" Spacing="16" Visibility="Collapsed">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Pagination" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}"/>
            <TextBlock Text="Eight pagers. Click a page or an arrow, or use the arrow keys, Home and End." FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <Grid ColumnSpacing="20" RowSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="1  Classic"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIClassicPager"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="96">
                <rw:ClassicPager x:Name="ClassicPager1" AutomationProperties.Name="Results pages" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" PageCount="10" Page="3" PageChanged="PageChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Numbered pages with arrows. Far from the ends, the pages in between fold into an ellipsis."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="2  Pills"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIPillsPager"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="96">
                <rw:PillsPager x:Name="PillsPager1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" PageChanged="PageChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Dots that stretch into a pill for the current page. The pill slides with a little lag."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="3  Dots"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIDotsPager"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="96">
                <rw:DotsPager x:Name="DotsPager1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" PageCount="12" PageChanged="PageChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A row of dots and double arrows. The current dot grows and glows."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="4  Bordered"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIBorderedPager"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="96">
                <rw:BorderedPager x:Name="BorderedPager1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" PageCount="8" PageChanged="PageChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="One frame around every page, the current one filled, with arrows at both ends."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="5  Track"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUITrackPager"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="96">
                <rw:TrackPager x:Name="TrackPager1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" PageCount="6" PageChanged="PageChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A thin track with a thumb that springs from page to page."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="6  Segmented"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUISegmentedPager"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="96">
                <rw:SegmentedPager x:Name="SegmentedPager1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" PageChanged="PageChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A segmented control: the current segment lights up and glows."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="7  Progress"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIProgressPager"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="96">
                <rw:ProgressPager x:Name="ProgressPager1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" PageCount="12" Page="4" PageChanged="PageChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Page 4 of 12 as a bar between two arrows. Click the bar to jump."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="8  Steps"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIStepsPager"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="96">
                <rw:StepsPager x:Name="StepsPager1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" PageCount="5" Page="2" PageChanged="PageChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Pages as steps on a line: done, current and still to come."/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <!-- Progress Steps -->
      <StackPanel x:Name="StepsPage" Grid.Row="2" Spacing="16" Visibility="Collapsed">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Progress Steps" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}"/>
            <TextBlock Text="Six ways to show where the user is in a flow. Click a step, or use Back and Next." FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="BackButton" Content="Back" Click="BackClick" MinWidth="80" CornerRadius="15" Height="30"/>
            <Button x:Name="NextButton" Content="Next" Click="NextClick" MinWidth="80" CornerRadius="15" Height="30" Style="{StaticResource AccentButtonStyle}"/>
          </StackPanel>
        </Grid>
        <Grid ColumnSpacing="20" RowSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="1  Numbered"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUINumberedSteps"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="150">
                <rw:NumberedSteps x:Name="NumberedSteps1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Step="2" StepChanged="StepChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Numbered circles on a line. The line fills to the next step and the number turns into a check."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="2  Segment Bar"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUISegmentBarSteps"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="150">
                <rw:SegmentBarSteps x:Name="SegmentBarSteps1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Step="2" StepChanged="StepChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="One segment per step, filling in turn, and the step number rolls over above it."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="3  Checkout Icons"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUICheckoutSteps"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="150">
                <rw:CheckoutSteps x:Name="CheckoutSteps1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Step="2" StepChanged="StepChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="An icon per step on a dotted path. A done step gets a check badge."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="4  Order Tracking"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIOrderTrackingSteps"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="150">
                <rw:OrderTrackingSteps x:Name="OrderTrackingSteps1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Step="3" StepChanged="StepChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A van drives along the road from stop to stop, with the order and its arrival above."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="5  Breadcrumb Arrows"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIBreadcrumbSteps"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="150">
                <rw:BreadcrumbSteps x:Name="BreadcrumbSteps1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Step="2" StepChanged="StepChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Arrow shaped steps. The colour wipes into the next arrow with a pointed edge."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="6  Ring"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIRingSteps"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="170">
                <rw:RingSteps x:Name="RingSteps1" HorizontalAlignment="Center" VerticalAlignment="Center" Step="2" Width="300" StepChanged="StepChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A ring of arcs around the step number, which rolls to the next one."/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <!-- Tab Bars -->
      <StackPanel x:Name="TabBarsPage" Grid.Row="2" Spacing="16" Visibility="Collapsed">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Tab Bars" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}"/>
            <TextBlock Text="The six tab bars of the Tab Bars category. A bar can show one page per tab with its Pages property, like the bar above." FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <Grid ColumnSpacing="20" RowSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="1  Sliding Pill"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUISlidingPillTabBar"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="150">
                <rw:SlidingPillTabBar x:Name="PillBar" Grid.Row="1" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12"
                    Background="{ThemeResource BarBrush}" BorderBrush="{ThemeResource BarEdgeBrush}" Foreground="{ThemeResource BarIconBrush}"
                    Items="Home:Home, Search:Search, Likes:Heart, Profile:Contact" SelectionChanged="TabChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A pill slides under the selected tab and stretches on the way."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="2  Liquid Bulge"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUILiquidBulgeTabBar"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="150">
                <rw:LiquidBulgeTabBar x:Name="BulgeBar" Grid.Row="1" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12"
                    Background="{ThemeResource BarBrush}" BorderBrush="{ThemeResource BarEdgeBrush}" Foreground="{ThemeResource BarIconBrush}"
                    Items="Listen:Music, Explore:Globe, Library:Library, Me:Contact" SelectionChanged="TabChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="The bar bulges up under the selected tab like a drop of liquid."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="3  Floating Notch"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIFloatingNotchTabBar"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="150">
                <rw:FloatingNotchTabBar x:Name="NotchBar" Grid.Row="1" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12"
                    Background="{ThemeResource BarBrush}" BorderBrush="{ThemeResource BarEdgeBrush}" Foreground="{ThemeResource BarIconBrush}"
                    Items="Shop:Shop, Cart:Cart, Saved:Heart, Account:Contact" SelectionChanged="TabChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="The selected icon floats in a circle above a notch cut into the bar."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="4  Icon Fill"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIIconFillTabBar"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="150">
                <rw:IconFillTabBar x:Name="FillBar" Grid.Row="1" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12"
                    Background="{ThemeResource BarBrush}" BorderBrush="{ThemeResource BarEdgeBrush}" Foreground="{ThemeResource BarIconBrush}"
                    Items="Feed:Home, Chat:Chat, Likes:Heart, Profile:Contact" SelectionChanged="TabChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="The selected icon fills in and a dot shows under it."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="5  Expanding Label"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIExpandingLabelTabBar"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="150">
                <rw:ExpandingLabelTabBar x:Name="LabelBar" Grid.Row="1" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12"
                    Background="{ThemeResource BarBrush}" BorderBrush="{ThemeResource BarEdgeBrush}" Foreground="{ThemeResource BarIconBrush}"
                    Items="Explore:Globe, Trips:Airplane, Saved:Star, Profile:Contact" SelectionChanged="TabChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="The selected tab widens to show its label."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="6  Bubble Float"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIBubbleFloatTabBar"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="150">
                <rw:BubbleFloatTabBar x:Name="BubbleBar" Grid.Row="1" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12"
                    Background="{ThemeResource BarBrush}" BorderBrush="{ThemeResource BarEdgeBrush}" Foreground="{ThemeResource BarIconBrush}" BubbleCount="9"
                    Items="Photos:Photo, Albums:Folder, Camera:Camera, Settings:Settings" SelectionChanged="TabChanged"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Bubbles rise from the selected tab."/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <!-- Action Buttons -->
      <StackPanel x:Name="ButtonsPage" Grid.Row="2" Spacing="16" Visibility="Collapsed">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="Action Buttons" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}"/>
            <TextBlock Text="The six buttons of the Action Buttons category." FontSize="13" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <Grid ColumnSpacing="20" RowSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="1  Hold to Confirm"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIHoldButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="176">
                <rw:HoldButton x:Name="HoldButton1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0"
                    Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceEdgeBrush}" Foreground="{ThemeResource SurfaceMutedBrush}"
                    Text="Hold to delete" DoneText="Deleted" Confirmed="ButtonDone"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Hold it down: a ring fills around the button, then it turns into a check."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="2  Paper Plane"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUISendButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="176">
                <rw:SendButton x:Name="SendButton1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Send" DoneText="Sent!" Click="ButtonDone"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="The paper plane flies off with a trail and the label flips to &quot;Sent!&quot;."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="3  Confetti Burst"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIConfettiButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="176">
                <rw:ConfettiButton x:Name="ConfettiButton1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                    Text="Celebrate" ConfettiCount="48" Click="ButtonDone"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A click bursts confetti out of the button. The pieces flutter and fall."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="4  Copy Feedback"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUICopyButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="176">
                <rw:CopyButton x:Name="CopyButton1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0"
                    Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceEdgeBrush}" Foreground="{ThemeResource SurfaceTextBrush}"
                    Text="join.app/x7Kq2" DoneText="Copied!" Copied="ButtonDone"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A click copies the text and the icon turns into a check."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="5  Shine Sweep"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIShineButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="176">
                <rw:ShineButton x:Name="ShineButton1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Upgrade to Pro" Click="ButtonDone"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A shine sweeps across the button and sparkles twinkle around it."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel Spacing="12">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="6  Slide to Confirm"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUISlideButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}" Height="176">
                <rw:SlideButton x:Name="SlideButton1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceEdgeBrush}" Foreground="{ThemeResource SurfaceMutedBrush}"
                    Text="Slide to confirm" DoneText="Confirmed" Confirmed="ButtonDone"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Drag the knob to the end: the track fills and the knob turns into a check."/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

        <!-- What the events report -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#E14FB4" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"
                     Text="Use any control. Their events report here."/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
