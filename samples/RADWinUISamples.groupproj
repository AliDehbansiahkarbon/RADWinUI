    </Target>
    <Target Name="Make">
        <CallTarget Targets="Gallery:Make;Luma:Make;Haven:Make;Lucent:Make;Notch:Make;Counter:Make;Greeter:Make;ListDemo:Make;Contacts:Make;Profile:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
