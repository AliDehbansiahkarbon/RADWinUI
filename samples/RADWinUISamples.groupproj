<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- The demos, built from source. Build RADWinUI.groupproj (or RADWinUI32.groupproj) first: their
         pre-build event runs bin\XamlCodeGen.exe. -->
    <PropertyGroup>
        <ProjectGuid>{51C6AF69-A754-4F86-A11D-ADBF4C2F4A26}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Gallery\Gallery.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Luma\Luma.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Haven\Haven.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Lucent\Lucent.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Notch\Notch.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Counter\Counter.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Greeter\Greeter.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="ListDemo\ListDemo.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Contacts\Contacts.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Profile\Profile.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="Gallery">
        <MSBuild Projects="Gallery\Gallery.dproj"/>
    </Target>
    <Target Name="Gallery:Clean">
        <MSBuild Projects="Gallery\Gallery.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Gallery:Make">
        <MSBuild Projects="Gallery\Gallery.dproj" Targets="Make"/>
    </Target>
    <Target Name="Luma">
        <MSBuild Projects="Luma\Luma.dproj"/>
    </Target>
    <Target Name="Luma:Clean">
        <MSBuild Projects="Luma\Luma.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Luma:Make">
        <MSBuild Projects="Luma\Luma.dproj" Targets="Make"/>
    </Target>
    <Target Name="Haven">
        <MSBuild Projects="Haven\Haven.dproj"/>
    </Target>
    <Target Name="Haven:Clean">
        <MSBuild Projects="Haven\Haven.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Haven:Make">
        <MSBuild Projects="Haven\Haven.dproj" Targets="Make"/>
    </Target>
    <Target Name="Lucent">
        <MSBuild Projects="Lucent\Lucent.dproj"/>
    </Target>
    <Target Name="Lucent:Clean">
        <MSBuild Projects="Lucent\Lucent.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Lucent:Make">
        <MSBuild Projects="Lucent\Lucent.dproj" Targets="Make"/>
    </Target>
    <Target Name="Notch">
        <MSBuild Projects="Notch\Notch.dproj"/>
    </Target>
    <Target Name="Notch:Clean">
        <MSBuild Projects="Notch\Notch.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Notch:Make">
        <MSBuild Projects="Notch\Notch.dproj" Targets="Make"/>
    </Target>
    <Target Name="Counter">
        <MSBuild Projects="Counter\Counter.dproj"/>
    </Target>
    <Target Name="Counter:Clean">
        <MSBuild Projects="Counter\Counter.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Counter:Make">
        <MSBuild Projects="Counter\Counter.dproj" Targets="Make"/>
    </Target>
    <Target Name="Greeter">
        <MSBuild Projects="Greeter\Greeter.dproj"/>
    </Target>
    <Target Name="Greeter:Clean">
        <MSBuild Projects="Greeter\Greeter.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Greeter:Make">
        <MSBuild Projects="Greeter\Greeter.dproj" Targets="Make"/>
