<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rw="using:RADWinUI.Controls"
    x:Class="TMainWindow" Title="Action Buttons" Width="1180" Height="880" MinWidth="1000" MinHeight="720"
    WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" Backdrop="Transparent">
  <!-- The six buttons of the Tool Palette's Action Buttons category, each on a
       card of its own. It follows the Windows theme: every colour of the page
       is a theme resource, and the buttons take theirs through Background,
       BorderBrush and Foreground. MainWindow.pas adds the controls at the top:
       the accent colours, Play all, and how much of the desktop shows through
       the window. Every button reports to the line at the bottom. -->
  <Grid x:Name="Root" Background="Transparent">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBrush" Color="#F3F2F7"/>
            <SolidColorBrush x:Key="CardBrush" Color="#E6FFFFFF"/>
            <SolidColorBrush x:Key="CardEdgeBrush" Color="#14000000"/>
            <SolidColorBrush x:Key="StageBrush" Color="#F3F2F8"/>
            <SolidColorBrush x:Key="InkBrush" Color="#1B1829"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#5E5A72"/>
            <SolidColorBrush x:Key="FaintBrush" Color="#85819A"/>
            <SolidColorBrush x:Key="ChipBrush" Color="#ECEAF4"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceEdgeBrush" Color="#DEDBE9"/>
            <SolidColorBrush x:Key="SurfaceTextBrush" Color="#2A2640"/>
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#6F6B85"/>
            <SolidColorBrush x:Key="SwatchEdgeBrush" Color="#D9D6E4"/>
            <Color x:Key="GlowColorA">#306C55FF</Color>
            <Color x:Key="GlowColorB">#2AFF5FA8</Color>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBrush" Color="#0E0D15"/>
            <SolidColorBrush x:Key="CardBrush" Color="#E615131F"/>
            <SolidColorBrush x:Key="CardEdgeBrush" Color="#25222F"/>
            <SolidColorBrush x:Key="StageBrush" Color="#100E17"/>
            <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#9A96B0"/>
            <SolidColorBrush x:Key="FaintBrush" Color="#77738C"/>
            <SolidColorBrush x:Key="ChipBrush" Color="#1F1C2C"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1829"/>
            <SolidColorBrush x:Key="SurfaceEdgeBrush" Color="#2E2A40"/>
            <SolidColorBrush x:Key="SurfaceTextBrush" Color="#D8D4EA"/>
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#A7A3BC"/>
            <SolidColorBrush x:Key="SwatchEdgeBrush" Color="#2E2A3D"/>
            <Color x:Key="GlowColorA">#486C55FF</Color>
            <Color x:Key="GlowColorB">#36FF5FA8</Color>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="Card" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
          <Setter Property="BorderBrush" Value="{ThemeResource CardEdgeBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="24"/>
          <Setter Property="Padding" Value="18,16,18,18"/>
        </Style>
        <Style x:Key="Stage" TargetType="Grid">
          <Setter Property="Background" Value="{ThemeResource StageBrush}"/>
          <Setter Property="CornerRadius" Value="16"/>
          <Setter Property="Height" Value="176"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
          <Setter Property="FontSize" Value="16"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
        </Style>
        <Style x:Key="CardClass" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
          <Setter Property="FontSize" Value="11.5"/>
          <Setter Property="Foreground" Value="{ThemeResource FaintBrush}"/>
        </Style>
        <Style x:Key="CardText" TargetType="TextBlock">
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource ChipBrush}"/>
          <Setter Property="CornerRadius" Value="11"/>
          <Setter Property="Padding" Value="10,3,10,4"/>
          <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
          <Setter Property="FontSize" Value="11.5"/>
          <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
          <Setter Property="FontSize" Value="11"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="CharacterSpacing" Value="80"/>
          <Setter Property="Foreground" Value="{ThemeResource FaintBrush}"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
          <Setter Property="Width" Value="30"/>
          <Setter Property="Height" Value="30"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="CornerRadius" Value="15"/>
          <Setter Property="BorderThickness" Value="2"/>
          <Setter Property="BorderBrush" Value="{ThemeResource SwatchEdgeBrush}"/>
        </Style>
      </ResourceDictionary>
    </Grid.Resources>

    <!-- The page itself. Its Opacity is the transparency slider: below 1 the desktop shows through -->
    <Border x:Name="Glass" Background="{ThemeResource PageBrush}" CornerRadius="8" Opacity="0.65"/>

    <!-- Two soft lights behind everything -->
    <Ellipse Width="820" Height="820" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-240,-320,0,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="{ThemeResource GlowColorA}" Offset="0"/>
          <GradientStop Color="#006C55FF" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-280,-360" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="{ThemeResource GlowColorB}" Offset="0"/>
          <GradientStop Color="#00FF5FA8" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <ScrollViewer>
      <Grid Padding="40,40,40,28" RowSpacing="24" MaxWidth="1240">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title and the controls that change every button at once -->
        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="6" VerticalAlignment="Center">
            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource ChipText}" Text="RADWinUI  &#x00B7;  Tool Palette  &#x00B7;  Action Buttons"/>
            </Border>
            <TextBlock Text="Six buttons that answer back" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}"/>
            <TextBlock Text="Drop one on a window, set its Text in the Object Inspector and handle one event. Try them all." FontSize="14" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,14,20,14" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="26">
              <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource Caption}" Text="ACCENT"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="OriginalSwatch" Style="{StaticResource Swatch}" Click="OriginalClick" ToolTipService.ToolTip="Each button's own colours" AutomationProperties.Name="Original">
                    <Ellipse Width="22" Height="22"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6C55FF" Offset="0"/><GradientStop Color="#FF5FA8" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
                  </Button>
                  <Button x:Name="SunsetSwatch" Style="{StaticResource Swatch}" Click="SunsetClick" ToolTipService.ToolTip="Sunset" AutomationProperties.Name="Sunset">
                    <Ellipse Width="22" Height="22"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF5F6D" Offset="0"/><GradientStop Color="#FFC371" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
                  </Button>
                  <Button x:Name="MintSwatch" Style="{StaticResource Swatch}" Click="MintClick" ToolTipService.ToolTip="Mint" AutomationProperties.Name="Mint">
                    <Ellipse Width="22" Height="22"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#11B98E" Offset="0"/><GradientStop Color="#7CF29A" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
                  </Button>
                  <Button x:Name="OceanSwatch" Style="{StaticResource Swatch}" Click="OceanClick" ToolTipService.ToolTip="Ocean" AutomationProperties.Name="Ocean">
                    <Ellipse Width="22" Height="22"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2B5CFF" Offset="0"/><GradientStop Color="#2BD9FF" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
                  </Button>
                </StackPanel>
              </StackPanel>
              <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource Caption}" Text="DEMO"/>
                <Button x:Name="PlayAllButton" Content="Play all" Click="PlayAllClick" MinWidth="88" CornerRadius="15" Height="30" Padding="14,0,14,0"/>
              </StackPanel>
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Style="{StaticResource Caption}" Text="TRANSPARENCY"/>
                  <TextBlock x:Name="GlassText" Style="{StaticResource Caption}" Foreground="{ThemeResource MutedBrush}" Text="35%"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <ToggleSwitch x:Name="TransparencySwitch" OnContent="" OffContent="" MinWidth="0" IsOn="True"
                                Toggled="TransparencyToggled" AutomationProperties.Name="Transparency"/>
                  <Slider x:Name="GlassSlider" Width="110" Minimum="0" Maximum="90" StepFrequency="5" Value="35"
                          ValueChanged="GlassChanged" AutomationProperties.Name="Transparency level" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <!-- The six buttons, each on a card of its own -->
        <Grid Grid.Row="1" ColumnSpacing="20" RowSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>

          <!-- 1. Hold to confirm -->
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="14">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="1  Hold to Confirm"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIHoldButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:HoldButton x:Name="HoldButton1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0"
                    Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceEdgeBrush}" Foreground="{ThemeResource SurfaceMutedBrush}"
                    Text="Hold to delete" DoneText="Deleted" Confirmed="HoldConfirmed"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Hold it down: a ring fills around the button, then it turns into a check. Let go early and the ring runs back."/>
            </StackPanel>
          </Border>

          <!-- 2. Paper plane -->
          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="14">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="2  Paper Plane"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUISendButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:SendButton x:Name="SendButton1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Text="Send" DoneText="Sent!" Click="SendClick"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="The paper plane flies off with a trail and the label flips to &quot;Sent!&quot;. It comes back after ResetAfter."/>
            </StackPanel>
          </Border>

          <!-- 3. Confetti burst -->
          <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel Spacing="14">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="3  Confetti Burst"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIConfettiButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:ConfettiButton x:Name="ConfettiButton1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                    Text="Celebrate" ConfettiCount="48" Click="ConfettiClick"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A click bursts confetti out of the button. The pieces flutter, turn over and fall."/>
            </StackPanel>
          </Border>

          <!-- 4. Copy feedback -->
          <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
            <StackPanel Spacing="14">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="4  Copy Feedback"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUICopyButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:CopyButton x:Name="CopyButton1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0"
                    Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceEdgeBrush}" Foreground="{ThemeResource SurfaceTextBrush}"
                    Text="join.app/x7Kq2" DoneText="Copied!" Copied="CopyCopied"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A click copies the text to the clipboard. The icon turns into a check and a &quot;Copied!&quot; tooltip pops up."/>
            </StackPanel>
          </Border>

          <!-- 5. Shine sweep -->
          <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="14">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="5  Shine Sweep"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIShineButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:ShineButton x:Name="ShineButton1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Text="Upgrade to Pro" Click="ShineClick"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="A diagonal shine sweeps across the button and sparkles twinkle around it. Hover it for one more shine."/>
            </StackPanel>
          </Border>

          <!-- 6. Slide to confirm -->
          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel Spacing="14">
              <StackPanel Spacing="1">
                <TextBlock Style="{StaticResource CardTitle}" Text="6  Slide to Confirm"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUISlideButton"/>
              </StackPanel>
              <Grid Style="{StaticResource Stage}">
                <rw:SlideButton x:Name="SlideButton1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceEdgeBrush}" Foreground="{ThemeResource SurfaceMutedBrush}"
                    Text="Slide to confirm" DoneText="Confirmed" Confirmed="SlideConfirmed"/>
              </Grid>
              <TextBlock Style="{StaticResource CardText}" Text="Drag the knob to the end: the track fills and the knob turns into a check. Enter or Space slides it too."/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- What the events report, and the XAML behind a button -->
        <Grid Grid.Row="2" ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF5FA8" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"
                       Text="Use any button, or press Play all. Their events report here."/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource Chip}" Padding="14,6,14,7">
            <TextBlock Style="{StaticResource CardClass}" Foreground="{ThemeResource MutedBrush}"
                       Text="&lt;rw:SlideButton Text=&quot;Slide to pay&quot; Confirmed=&quot;PayConfirmed&quot;/&gt;"/>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
