<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TProfilePage">
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="20">
        <PersonPicture x:Name="Picture" Width="88" Height="88" d:DisplayName="Ada Lovelace"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" d:Text="Ada Lovelace"/>
          <TextBlock x:Name="Subtitle" Opacity="0.7" d:Text="Engineering lead"/>
        </StackPanel>
      </StackPanel>
      <TextBox x:Name="NameBox" Header="Name" TextChanged="FieldChanged" AutomationProperties.Name="Name"/>
      <TextBox x:Name="RoleBox" Header="Role" TextChanged="FieldChanged" AutomationProperties.Name="Role"/>
      <TextBox x:Name="EmailBox" Header="Email" TextChanged="FieldChanged" AutomationProperties.Name="Email"/>
      <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
               TextChanged="FieldChanged" AutomationProperties.Name="Notes"/>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveClick"
                IsEnabled="False"/>
        <TextBlock x:Name="Status" VerticalAlignment="Center" Opacity="0.7" d:Text="Saved"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>