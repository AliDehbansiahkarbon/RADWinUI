<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TPersonCard">
  <!-- A clickable card for one person, used several times on the Home page -->
  <Button x:Name="CardButton" Click="CardClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
          Padding="16,14" CornerRadius="8" BorderThickness="1"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
    <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <PersonPicture x:Name="Picture" Width="44" Height="44" d:DisplayName="Ada Lovelace"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="NameText" FontWeight="SemiBold" d:Text="Ada Lovelace"/>
        <TextBlock x:Name="RoleText" FontSize="12" Opacity="0.7" d:Text="Engineering lead"/>
      </StackPanel>
      <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.6"/>
    </Grid>
  </Button>
</UserControl>