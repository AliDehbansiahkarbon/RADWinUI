<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TMainWindow"
    Title="Crew" Width="1080" Height="720" MinWidth="640" MinHeight="480"
    WindowStartupLocation="CenterScreen" Backdrop="Mica">
  <!-- The menu items name their page class in Tag, the frame shows one page at a time -->
  <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Visible" OpenPaneLength="220"
                  PaneTitle="Crew">
    <NavigationView.MenuItems>
      <NavigationViewItem Content="Home" Tag="THomePage">
        <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="People" Tag="TPeoplePage">
        <NavigationViewItem.Icon><FontIcon Glyph="&#xE716;"/></NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>
    <Frame x:Name="ContentFrame" Padding="32,24,32,24"/>
  </NavigationView>
</Window>