<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TSettingsPage">
  <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock x:Name="PageTitle" Text="Settings" Style="{StaticResource TitleLargeTextBlockStyle}"/>
    <TextBlock Text="History" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
    <TextBlock x:Name="HistoryText" TextWrapping="Wrap" d:Text="3 pages behind this one: Home, People, Ada Lovelace"/>
    <Button x:Name="ClearButton" Content="Clear history" Click="ClearClick"/>
    <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
    <TextBlock TextWrapping="Wrap" Opacity="0.8"
               Text="Crew is a RADWinUI sample. Each page is a .xaml file with its .pas unit, the cards on the Home page are one user control used three times, and the frame keeps the back stack for the back button."/>
  </StackPanel>
</Page>