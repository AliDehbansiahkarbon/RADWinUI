<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rw="using:RADWinUI.Controls"
    x:Class="TMainWindow" Title="Notch" Width="720" Height="300"
    WindowStyle="Overlay" Backdrop="Transparent" Dock="TopCenter" ClickThrough="Background" ShowActivated="False">
  <!-- A desk companion that hangs from the top of the screen: a black pill with
       the time, which opens into a panel with a build monitor, the music playing
       on the PC and a focus timer. Ctrl+Alt+N opens and closes it. -->
  <Grid RequestedTheme="Dark" Background="Transparent">
    <Grid.Resources>
      <SolidColorBrush x:Key="TileBrush" Color="#161618"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#8E8E93"/>
      <SolidColorBrush x:Key="FaintBrush" Color="#2C2C2E"/>
    </Grid.Resources>

    <rw:NotchPanel x:Name="Notch" CollapsedWidth="220" CollapsedHeight="36" ExpandedWidth="680" ExpandedHeight="276"
                   ExpandedCornerRadius="30" Padding="22,14,22,18"
                   IsExpanded="False">
      <rw:NotchPanel.Pill>
        <Grid Width="196" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="PillDot" Width="8" Height="8" Fill="#3DDC84" VerticalAlignment="Center"/>
          <TextBlock x:Name="PillClock" Grid.Column="1" Text="00:00" FontSize="13" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <FontIcon x:Name="PillMusic" Grid.Column="2" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8D6;"
                    FontSize="12" Foreground="#2EC4B6" Opacity="0" VerticalAlignment="Center"/>
        </Grid>
      </rw:NotchPanel.Pill>

      <Grid RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: date, time, pin and quit -->
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock x:Name="ClockLabel" Text="00:00" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="DateLabel" Text="Thursday, 29 October" FontSize="13" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Bottom" Margin="0,0,0,3"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="Ctrl+Alt+N" FontSize="11" Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <!-- Off, the notch is solid black. On, the desktop shows through it -->
          <ToggleSwitch x:Name="TransparencySwitch" Grid.Column="2" OnContent="Transparency" OffContent="Transparency"
                        MinWidth="0" FontSize="12" VerticalAlignment="Center" AutomationProperties.Name="Transparency"/>
          <Button x:Name="PinButton" Grid.Column="3" Width="32" Height="32" Padding="0" CornerRadius="16"
                  Background="{StaticResource FaintBrush}" BorderThickness="0" ToolTipService.ToolTip="Keep open">
            <FontIcon x:Name="PinGlyph" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE718;" FontSize="13"/>
          </Button>
          <Button x:Name="QuitButton" Grid.Column="4" Width="32" Height="32" Padding="0" CornerRadius="16"
                  Background="{StaticResource FaintBrush}" BorderThickness="0" ToolTipService.ToolTip="Quit">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE711;" FontSize="12"/>
          </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Build: orange while it runs, blue when it is done, then it settles to green -->
          <rw:GlowTile x:Name="BuildTile" Background="{StaticResource TileBrush}" CornerRadius="20" Padding="16,14"
                       GlowBrush="#3DDC84" GlowRadius="26" GlowOpacity="0.55">
            <Grid RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE90F;" FontSize="13"
                          Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Build" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
              <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="BuildStatus" Text="Ready" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="BuildDetail" Text="Last build passed" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <ProgressBar x:Name="BuildProgress" Grid.Row="2" Maximum="4" Value="0" Foreground="#FF8A3D"/>
              <Button x:Name="BuildButton" Grid.Row="3" Content="Run build" HorizontalAlignment="Stretch" CornerRadius="10"
                      Background="{StaticResource FaintBrush}" BorderThickness="0"/>
            </Grid>
          </rw:GlowTile>

          <!-- Now playing: whatever plays on the PC, as Windows sees it -->
          <rw:GlowTile x:Name="MusicTile" Grid.Column="1" Background="{StaticResource TileBrush}" CornerRadius="20"
                       Padding="16,14" GlowBrush="#2EC4B6" GlowRadius="26" GlowOpacity="0.5" IsGlowing="False">
            <Grid RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8D6;" FontSize="13"
                          Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="MusicSource" Text="Now playing" FontSize="13" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="MusicTitle" Text="Nothing playing" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MusicArtist" Text="Start music in any app" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button x:Name="PreviousButton" Width="36" Height="36" Padding="0" CornerRadius="18"
                        Background="Transparent" BorderThickness="0">
                  <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE892;" FontSize="14"/>
                </Button>
                <Button x:Name="PlayButton" Width="44" Height="44" Padding="0" CornerRadius="22" Background="White"
                        BorderThickness="0">
                  <FontIcon x:Name="PlayGlyph" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE768;"
                            FontSize="16" Foreground="Black"/>
                </Button>
                <Button x:Name="NextButton" Width="36" Height="36" Padding="0" CornerRadius="18"
                        Background="Transparent" BorderThickness="0">
                  <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE893;" FontSize="14"/>
                </Button>
              </StackPanel>
            </Grid>
          </rw:GlowTile>

          <!-- Focus: a 25 minute timer that glows while it runs -->
          <rw:GlowTile x:Name="FocusTile" Grid.Column="2" Background="{StaticResource TileBrush}" CornerRadius="20"
                       Padding="16,14" GlowBrush="#A77BFF" GlowRadius="26" GlowOpacity="0.6" IsGlowing="False">
            <Grid RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE916;" FontSize="13"
                          Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Focus" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
              <TextBlock x:Name="FocusClock" Grid.Row="1" Text="25:00" FontSize="40" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="FocusButton" Content="Start" HorizontalAlignment="Stretch" CornerRadius="10"
                        Background="{StaticResource FaintBrush}" BorderThickness="0"/>
                <Button x:Name="ResetButton" Grid.Column="1" Width="36" Padding="0" CornerRadius="10"
                        Background="{StaticResource FaintBrush}" BorderThickness="0" ToolTipService.ToolTip="Reset">
                  <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72C;" FontSize="13"/>
                </Button>
              </Grid>
            </Grid>
          </rw:GlowTile>
        </Grid>
      </Grid>
    </rw:NotchPanel>

    <rw:HotKey x:Name="ToggleKey" Keys="Ctrl+Alt+N"/>
    <rw:MediaSession x:Name="Media"/>
  </Grid>
</Window>
