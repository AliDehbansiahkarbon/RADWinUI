<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TProfileWindow"
    Title="Profile" Width="420" Height="460"
    DataContextType="TProfile">
    <StackPanel Spacing="12" Padding="24">
        <!-- d: values show in the live preview only; Summary and CityUpper show their binding path -->
        <TextBox x:Name="NameBox" Header="Name" d:Text="Ada Lovelace"
                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox x:Name="CityBox" Header="City" d:Text="London"
                 Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox x:Name="VipBox" Content="VIP" IsChecked="{Binding IsVip, Mode=TwoWay}" d:IsChecked="True"/>
        <TextBlock x:Name="Summary" Text="{Binding Summary}" FontSize="20"/>
        <!-- Converters: built-in Format and BoolToVisibility, Upper registered in Profile.dpr -->
        <TextBlock x:Name="Greeting" Text="{Binding Name, Converter={StaticResource Format}, ConverterParameter='Hello, %s!'}" d:Text="Hello, Ada Lovelace!"/>
        <TextBlock x:Name="CityUpper" Text="{Binding City, Converter={StaticResource Upper}}"/>
        <TextBlock x:Name="VipBadge" Text="VIP customer"
                   Visibility="{Binding IsVip, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Reset from code" Click="ResetClick"/>
    </StackPanel>
</Window>