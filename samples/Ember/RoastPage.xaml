<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rw="using:RADWinUI.Controls"
    mc:Ignorable="d"
    x:Class="TRoastPage">
  <!-- The roast that runs now: the bean temperature curve, live, with the
       phases of a roast. RoastPage.pas draws the curve on the canvas each time
       the roast session ticks. -->
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="EmberAccentSoft" Color="{ThemeResource SystemAccentColor}" Opacity="0.16"/>
          <SolidColorBrush x:Key="EmberAccentFaint" Color="{ThemeResource SystemAccentColor}" Opacity="0.25"/>
          <SolidColorBrush x:Key="EmberAccentHalf" Color="{ThemeResource SystemAccentColor}" Opacity="0.5"/>
          <SolidColorBrush x:Key="EmberFrom" Color="{ThemeResource SystemAccentColorLight2}"/>
          <SolidColorBrush x:Key="EmberTo" Color="{ThemeResource SystemAccentColorDark1}"/>
          <LinearGradientBrush x:Key="CurveBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="0"/>
            <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0.55"/>
            <GradientStop Color="{ThemeResource SystemAccentColorDark2}" Offset="1"/>
          </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="EmberAccentSoft" Color="{ThemeResource SystemAccentColor}" Opacity="0.16"/>
          <SolidColorBrush x:Key="EmberAccentFaint" Color="{ThemeResource SystemAccentColor}" Opacity="0.25"/>
          <SolidColorBrush x:Key="EmberAccentHalf" Color="{ThemeResource SystemAccentColor}" Opacity="0.5"/>
          <SolidColorBrush x:Key="EmberFrom" Color="{ThemeResource SystemAccentColorLight2}"/>
          <SolidColorBrush x:Key="EmberTo" Color="{ThemeResource SystemAccentColorDark1}"/>
          <LinearGradientBrush x:Key="CurveBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="0"/>
            <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0.55"/>
            <GradientStop Color="{ThemeResource SystemAccentColorDark2}" Offset="1"/>
          </LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20,16,20,18"/>
      </Style>
      <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
      </Style>
      <Style x:Key="Big" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style x:Key="TileIcon" TargetType="FontIcon">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
      </Style>
      <Style x:Key="Phase" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,5,14,6"/>
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
      </Style>
      <Style x:Key="PhaseLit" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
      </Style>
      <Style x:Key="AxisText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
      </Style>
    </ResourceDictionary>
  </Page.Resources>

  <Grid RowSpacing="16" Padding="0,4,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Title, and what the roaster can do -->
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock x:Uid="RoasteryTitle" Text="Roastery" FontSize="32" FontWeight="SemiBold"/>
        <TextBlock x:Name="BatchText" Style="{StaticResource Label}" FontSize="14" d:Text="Batch #42  -  Yirgacheffe, 12 kg"/>
      </StackPanel>
      <Button x:Name="PopOutButton" Grid.Column="1" VerticalAlignment="Center" Click="PopOutClick"
              AutomationProperties.Name="Mini roaster">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
          <TextBlock x:Uid="PopOutText" Text="Mini roaster"/>
        </StackPanel>
      </Button>
      <rw:HoldButton x:Name="DropButton" x:Uid="DropButton" Grid.Column="2" VerticalAlignment="Center"
                     Text="Hold to drop" DoneText="Dropped" Icon="E896" HoldDuration="1000" AccentFrom="{ThemeResource EmberFrom}" AccentTo="{ThemeResource EmberTo}"
                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Confirmed="DropConfirmed"/>
    </Grid>

    <!-- The numbers a roaster watches -->
    <Grid Grid.Row="1" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Border x:Name="TempTile" Style="{StaticResource Card}">
        <Grid>
          <FontIcon Style="{StaticResource TileIcon}" Glyph="&#xE9CA;"/>
          <StackPanel Spacing="4">
            <TextBlock x:Uid="BeanTempLabel" Style="{StaticResource Label}" Text="Bean temperature"/>
            <TextBlock x:Name="TempText" Style="{StaticResource Big}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" d:Text="187&#x00B0;C"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="TimeTile" Grid.Column="1" Style="{StaticResource Card}">
        <Grid>
          <FontIcon Style="{StaticResource TileIcon}" Glyph="&#xE916;"/>
          <StackPanel Spacing="4">
            <TextBlock x:Uid="RoastTimeLabel" Style="{StaticResource Label}" Text="Roast time"/>
            <TextBlock x:Name="TimeText" Style="{StaticResource Big}" d:Text="7:35"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="RorTile" Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <FontIcon Style="{StaticResource TileIcon}" Glyph="&#xEC4A;"/>
          <StackPanel Spacing="4">
            <TextBlock x:Uid="RorLabel" Style="{StaticResource Label}" Text="Rate of rise"/>
            <TextBlock x:Name="RorText" Style="{StaticResource Big}" d:Text="9.4&#x00B0;/min"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="DevTile" Grid.Column="3" Style="{StaticResource Card}">
        <Grid>
          <FontIcon Style="{StaticResource TileIcon}" Glyph="&#xECAD;"/>
          <StackPanel Spacing="4">
            <TextBlock x:Uid="DevLabel" Style="{StaticResource Label}" Text="Development"/>
            <TextBlock x:Name="DevText" Style="{StaticResource Big}" d:Text="1:25"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- The curve -->
    <Border x:Name="ChartCard" Grid.Row="2" Style="{StaticResource Card}">
      <Grid RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Grid x:Name="DryingChip">
            <Border x:Name="DryingLit" Style="{StaticResource PhaseLit}" Opacity="0"/>
            <Border Style="{StaticResource Phase}"><TextBlock x:Uid="PhaseDrying" Text="Drying"/></Border>
          </Grid>
          <Grid x:Name="MaillardChip">
            <Border x:Name="MaillardLit" Style="{StaticResource PhaseLit}" Opacity="0"/>
            <Border Style="{StaticResource Phase}"><TextBlock x:Uid="PhaseMaillard" Text="Maillard"/></Border>
          </Grid>
          <Grid x:Name="DevelopmentChip">
            <Border x:Name="DevelopmentLit" Style="{StaticResource PhaseLit}" Opacity="0"/>
            <Border Style="{StaticResource Phase}"><TextBlock x:Uid="PhaseDevelopment" Text="Development"/></Border>
          </Grid>
          <Grid x:Name="DoneChip">
            <Border x:Name="DoneLit" Style="{StaticResource PhaseLit}" Opacity="0"/>
            <Border Style="{StaticResource Phase}"><TextBlock x:Uid="PhaseDone" Text="Done"/></Border>
          </Grid>
        </StackPanel>
        <Grid Grid.Row="1">
          <Canvas x:Name="Plot" SizeChanged="PlotSizeChanged">
            <Polyline x:Name="Grid100" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1"/>
            <Polyline x:Name="Grid150" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1" StrokeDashArray="4,4"/>
            <Polyline x:Name="Grid200" Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1"/>
            <Polyline x:Name="CrackLine" Stroke="{ThemeResource EmberAccentHalf}" StrokeThickness="1.5" StrokeDashArray="3,3"/>
            <TextBlock x:Name="Label100" Style="{StaticResource AxisText}" Text="100&#x00B0;"/>
            <TextBlock x:Name="Label150" Style="{StaticResource AxisText}" Text="150&#x00B0;  Maillard"/>
            <TextBlock x:Name="Label200" Style="{StaticResource AxisText}" Text="200&#x00B0;"/>
            <TextBlock x:Name="CrackLabel" x:Uid="CrackLabel" Style="{StaticResource AxisText}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="First crack"
                       Visibility="Collapsed"/>
            <Polyline x:Name="Curve" Stroke="{StaticResource CurveBrush}" StrokeThickness="3.5" StrokeLineJoin="Round"/>
            <Ellipse x:Name="Glow" Width="26" Height="26" Fill="{ThemeResource EmberAccentFaint}" Visibility="Collapsed"/>
            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{ThemeResource AccentFillColorDefaultBrush}" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
          </Canvas>
          <!-- No roast yet -->
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xEC32;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock x:Uid="EmptyTitle" Text="The roaster is ready" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Uid="EmptyText" Text="Start a batch here or from the dashboard, and watch the curve grow."
                       Style="{StaticResource Label}" HorizontalAlignment="Center"/>
            <Button x:Name="QuickStartButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                    Click="QuickStartClick" AutomationProperties.Name="Start a batch" d:Content="Roast 12 kg of Yirgacheffe"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
