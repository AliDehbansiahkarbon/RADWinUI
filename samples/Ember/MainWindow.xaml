<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TMainWindow"
    Title="Ember" Width="1320" Height="840" MinWidth="1040" MinHeight="700"
    WindowStartupLocation="CenterScreen" Backdrop="Mica" TitleBar="AppTitleBar">
  <!-- Ember: a coffee roastery's app. The title bar holds the search, the
       NavigationView drives a frame of pages, and the pane footer shows the
       roast that runs right now, whatever page is open. -->
  <Grid x:Name="Root">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EmberAccentSoft" Color="{ThemeResource SystemAccentColor}" Opacity="0.16"/>
            <SolidColorBrush x:Key="EmberAccentFaint" Color="{ThemeResource SystemAccentColor}" Opacity="0.25"/>
            <SolidColorBrush x:Key="EmberAccentHalf" Color="{ThemeResource SystemAccentColor}" Opacity="0.5"/>
            <SolidColorBrush x:Key="EmberFrom" Color="{ThemeResource SystemAccentColorLight2}"/>
            <SolidColorBrush x:Key="EmberTo" Color="{ThemeResource SystemAccentColorDark1}"/>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="EmberAccentSoft" Color="{ThemeResource SystemAccentColor}" Opacity="0.16"/>
            <SolidColorBrush x:Key="EmberAccentFaint" Color="{ThemeResource SystemAccentColor}" Opacity="0.25"/>
            <SolidColorBrush x:Key="EmberAccentHalf" Color="{ThemeResource SystemAccentColor}" Opacity="0.5"/>
            <SolidColorBrush x:Key="EmberFrom" Color="{ThemeResource SystemAccentColorLight2}"/>
            <SolidColorBrush x:Key="EmberTo" Color="{ThemeResource SystemAccentColorDark1}"/>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="Ember" x:Uid="AppTitleBar" Subtitle="Roastery">
      <TitleBar.IconSource>
        <FontIconSource Glyph="&#xECAD;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
      </TitleBar.IconSource>
      <TitleBar.Content>
        <!-- Typing filters the orders at once and suggests cafes and coffees; Enter or a suggestion opens Orders -->
        <AutoSuggestBox x:Name="SearchBox" x:Uid="SearchBox" PlaceholderText="Search orders, cafes or coffees" QueryIcon="Find" Width="380"
                        TextChanged="SearchTextChanged" QuerySubmitted="SearchSubmitted" AutomationProperties.Name="Search">
          <AutoSuggestBox.ItemTemplate>
            <DataTemplate x:DataType="TSuggestion">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="{Binding Glyph}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="{Binding Name}"/>
                <TextBlock Text="{Binding Kind}" Opacity="0.6"/>
              </StackPanel>
            </DataTemplate>
          </AutoSuggestBox.ItemTemplate>
        </AutoSuggestBox>
      </TitleBar.Content>
    </TitleBar>

    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Visible" OpenPaneLength="240"
                    IsSettingsVisible="True">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Uid="NavDashboard" Content="Dashboard" Tag="THomePage">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xF0E2;"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Uid="NavOrders" Content="Orders" Tag="TOrdersPage">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BF;"/></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Uid="NavRoastery" Content="Roastery" Tag="TRoastPage">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xECAD;"/></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <!-- The roast of the moment, on every page: a click opens the Roastery -->
      <NavigationView.PaneFooter>
        <Button x:Name="RoastBadge" Margin="12,0,12,12" Padding="14,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                CornerRadius="12" Click="RoastBadgeClick" AutomationProperties.Name="Current roast">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="36" Height="36">
              <Ellipse x:Name="BadgeGlow" Fill="{ThemeResource EmberAccentSoft}"/>
              <FontIcon Glyph="&#xECAD;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Grid>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock x:Name="BadgeTitle" x:Uid="BadgeTitle" Text="Roaster idle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="BadgeText" x:Uid="BadgeText" Text="Ready for the next batch" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
              <ProgressBar x:Name="BadgeProgress" Maximum="660" Value="0" Margin="0,6,0,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </StackPanel>
          </Grid>
        </Button>
      </NavigationView.PaneFooter>

      <Frame x:Name="ContentFrame" Padding="32,12,32,24"/>
    </NavigationView>
  </Grid>
</Window>
