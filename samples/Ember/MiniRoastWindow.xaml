<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TMiniRoastWindow"
    Title="Ember roaster" Width="320" Height="200" Backdrop="Acrylic" WindowState="CompactOverlay">
  <!-- CompactOverlay: a small window above every other window, like picture-in-picture -->
  <Grid Padding="18,14,18,16" RowSpacing="6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <FontIcon Glyph="&#xECAD;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
      <TextBlock x:Name="TitleText" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" d:Text="Batch #42  Yirgacheffe"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TempText" FontSize="46" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" d:Text="196&#x00B0;"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock x:Name="TimeText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" d:Text="8:10"/>
        <TextBlock x:Name="PhaseText" FontSize="12" Opacity="0.75" HorizontalAlignment="Right" d:Text="First crack"/>
      </StackPanel>
    </Grid>
    <ProgressBar x:Name="Progress" Grid.Row="2" Maximum="660" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
  </Grid>
</Window>
