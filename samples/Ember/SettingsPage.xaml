<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TSettingsPage">
  <Page.Resources>
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20,14"/>
    </Style>
    <Style x:Key="RowIcon" TargetType="FontIcon">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Page.Resources>

  <ScrollViewer>
    <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left" Padding="0,4,0,0">
      <TextBlock x:Uid="SettingsTitle" Text="Settings" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,12"/>

      <Border Style="{StaticResource Row}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xE790;"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Uid="ThemeTitle" Text="Theme" FontWeight="SemiBold"/>
            <TextBlock x:Uid="ThemeText" Text="Light, dark, or the same as Windows" FontSize="12" Opacity="0.7"/>
          </StackPanel>
          <ComboBox x:Name="ThemeBox" Grid.Column="2" Width="200" SelectionChanged="ThemeChanged" AutomationProperties.Name="Theme">
            <ComboBoxItem x:Uid="ThemeSystem" Content="Windows default"/>
            <ComboBoxItem x:Uid="ThemeLight" Content="Light"/>
            <ComboBoxItem x:Uid="ThemeDark" Content="Dark"/>
          </ComboBox>
        </Grid>
      </Border>

      <Border Style="{StaticResource Row}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xF2B7;"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Uid="LanguageTitle" Text="Language" FontWeight="SemiBold"/>
            <TextBlock x:Uid="LanguageText" Text="Ember starts again in the new language" FontSize="12" Opacity="0.7"/>
          </StackPanel>
          <ComboBox x:Name="LanguageBox" Grid.Column="2" Width="200" SelectionChanged="LanguageChanged" AutomationProperties.Name="Language"/>
        </Grid>
      </Border>

      <Border Style="{StaticResource Row}">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <FontIcon Style="{StaticResource RowIcon}" Glyph="&#xEA8F;"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Uid="NotifyTitle" Text="Notifications" FontWeight="SemiBold"/>
            <TextBlock x:Uid="NotifyText" Text="Windows tells you when a batch is ready" FontSize="12" Opacity="0.7"/>
          </StackPanel>
          <Button x:Name="TestNoteButton" x:Uid="TestNoteButton" Grid.Column="2" Content="Send a test" Click="TestNoteClick"/>
        </Grid>
      </Border>

      <Border Style="{StaticResource Row}" Margin="0,16,0,0">
        <StackPanel Spacing="6">
          <TextBlock x:Uid="AboutTitle" Text="About Ember" FontWeight="SemiBold"/>
          <TextBlock x:Uid="AboutText" TextWrapping="Wrap" Opacity="0.8"
                     Text="Ember is a RADWinUI sample: a native WinUI 3 app written in Delphi. Its pages are XAML files with Object Pascal units, its data is FireDAC, and it ships as a plain Win64 program."/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
