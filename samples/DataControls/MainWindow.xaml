<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rw="using:RADWinUI.Controls"
    x:Class="TMainWindow" Title="Data Controls" Width="1280" Height="1010" MinWidth="1100" MinHeight="800"
    WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" Backdrop="Transparent">
  <!-- The Tool Palette's Data Controls on one page. Every control is bound in
       XAML with DataSource and DataField only: the data sources are in the
       CustomerData data module (CustomerData.pas). The customers grid, the
       form, the tiles and the orders all follow the same cursor. The page
       follows the Windows theme, and MainWindow.pas adds the status line and
       how much of the desktop shows through the window. -->
  <Grid x:Name="Root" Background="Transparent">
    <Grid.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBrush" Color="#F2F5F8"/>
            <SolidColorBrush x:Key="CardBrush" Color="#E6FFFFFF"/>
            <SolidColorBrush x:Key="CardEdgeBrush" Color="#14000000"/>
            <SolidColorBrush x:Key="InkBrush" Color="#16202B"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#566473"/>
            <SolidColorBrush x:Key="FaintBrush" Color="#7F8C99"/>
            <SolidColorBrush x:Key="ChipBrush" Color="#E6ECF2"/>
            <SolidColorBrush x:Key="TileBrush" Color="#F6F8FB"/>
            <Color x:Key="GlowColorA">#2C1F8FFF</Color>
            <Color x:Key="GlowColorB">#2422C3A6</Color>
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBrush" Color="#0D1117"/>
            <SolidColorBrush x:Key="CardBrush" Color="#E6141A22"/>
            <SolidColorBrush x:Key="CardEdgeBrush" Color="#232B36"/>
            <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#97A3B2"/>
            <SolidColorBrush x:Key="FaintBrush" Color="#728090"/>
            <SolidColorBrush x:Key="ChipBrush" Color="#1C2430"/>
            <SolidColorBrush x:Key="TileBrush" Color="#18202A"/>
            <Color x:Key="GlowColorA">#441F8FFF</Color>
            <Color x:Key="GlowColorB">#3022C3A6</Color>
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="Card" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource CardBrush}"/>
          <Setter Property="BorderBrush" Value="{ThemeResource CardEdgeBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="20"/>
          <Setter Property="Padding" Value="20,16,20,20"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
          <Setter Property="FontSize" Value="16"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardClass" TargetType="TextBlock">
          <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
          <Setter Property="FontSize" Value="11.5"/>
          <Setter Property="Foreground" Value="{ThemeResource FaintBrush}"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource ChipBrush}"/>
          <Setter Property="CornerRadius" Value="11"/>
          <Setter Property="Padding" Value="10,3,10,4"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
          <Setter Property="FontSize" Value="11.5"/>
          <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
          <Setter Property="FontSize" Value="11"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="CharacterSpacing" Value="80"/>
          <Setter Property="Foreground" Value="{ThemeResource FaintBrush}"/>
        </Style>
        <!-- One customer as a tile: the bindings are field names -->
        <DataTemplate x:Key="CustomerTile">
          <Border Width="190" Padding="14,10,14,12" CornerRadius="12" Background="{ThemeResource TileBrush}">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding City}" FontSize="12" Opacity="0.7"/>
              <TextBlock Text="{Binding Tier}" FontSize="12" Opacity="0.7"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ResourceDictionary>
    </Grid.Resources>

    <!-- The page itself. Its Opacity is the transparency slider: below 1 the desktop shows through -->
    <Border x:Name="Glass" Background="{ThemeResource PageBrush}" CornerRadius="8" Opacity="0.65"/>

    <!-- Two soft lights behind everything -->
    <Ellipse Width="820" Height="820" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-340,0,0" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="{ThemeResource GlowColorA}" Offset="0"/>
          <GradientStop Color="#001F8FFF" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-380" IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="{ThemeResource GlowColorB}" Offset="0"/>
          <GradientStop Color="#0022C3A6" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <ScrollViewer>
      <Grid Padding="36,28,36,16" RowSpacing="20" MaxWidth="1320">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title and the transparency switch -->
        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="6" VerticalAlignment="Center">
            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left">
              <TextBlock Style="{StaticResource ChipText}" Text="RADWinUI  &#x00B7;  Tool Palette  &#x00B7;  Data Controls"/>
            </Border>
            <TextBlock Text="Customers and their orders" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}"/>
            <TextBlock Text="Every control on this page is bound with DataSource and DataField, the Delphi way. The data is three FireDAC memory tables in a data module." FontSize="14" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,14,20,14" VerticalAlignment="Center">
            <StackPanel Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Style="{StaticResource Caption}" Text="TRANSPARENCY"/>
                <TextBlock x:Name="GlassText" Style="{StaticResource Caption}" Foreground="{ThemeResource MutedBrush}" Text="35%"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleSwitch x:Name="TransparencySwitch" OnContent="" OffContent="" MinWidth="0" IsOn="True"
                              Toggled="TransparencyToggled" AutomationProperties.Name="Transparency"/>
                <Slider x:Name="GlassSlider" Width="110" Minimum="0" Maximum="90" StepFrequency="5" Value="35"
                        ValueChanged="GlassChanged" AutomationProperties.Name="Transparency level" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <!-- The customers: a grid with its navigator, and the current customer as a form -->
        <Grid Grid.Row="1" ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource Card}">
            <Grid RowSpacing="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Customers"/>
                  <TextBlock Style="{StaticResource CardClass}" Text="TWinUIDBGrid  &#x00B7;  TWinUIDBNavigator"/>
                </StackPanel>
                <rw:DBNavigator x:Name="CustomersNavigator" AutomationProperties.Name="Customers navigator" Grid.Column="1" DataSource="CustomersSource"/>
              </Grid>
              <rw:DBGrid x:Name="CustomersGrid" AutomationProperties.Name="Customers" Grid.Row="1" DataSource="CustomersSource" ReadOnly="True" Width="Auto" Height="452"
                         Columns="Name:180, City:120, Tier:80, Balance:110, Joined:150"/>
            </Grid>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="14">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <rw:DBImage x:Name="LogoImage" DataSource="CustomersSource" DataField="Logo" Width="56" Height="56" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <rw:DBText x:Name="NameText" DataSource="CustomersSource" DataField="Name" FontSize="20" FontWeight="SemiBold"/>
                  <rw:DBText x:Name="CityText" DataSource="CustomersSource" DataField="City" Foreground="{ThemeResource MutedBrush}"/>
                </StackPanel>
              </Grid>
              <Grid ColumnSpacing="14" RowSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <rw:DBEdit x:Name="NameEdit" DataSource="CustomersSource" DataField="Name" Header="Name"/>
                <rw:DBEdit x:Name="CityEdit" Grid.Column="1" DataSource="CustomersSource" DataField="City" Header="City"/>
                <rw:DBLookupComboBox x:Name="CountryCombo" Grid.Row="1" DataSource="CustomersSource" DataField="CountryID"
                                     ListSource="CountriesSource" KeyField="ID" ListField="CountryName" Header="Country"/>
                <rw:DBNumberBox x:Name="BalanceBox" Grid.Row="1" Grid.Column="1" DataSource="CustomersSource" DataField="Balance" Header="Balance"/>
                <rw:DBRadioGroup x:Name="TierRadio" Grid.Row="2" DataSource="CustomersSource" DataField="Tier"
                                 Items="Bronze, Silver, Gold" Columns="3" Header="Tier"/>
                <rw:DBDatePicker x:Name="JoinedPicker" Grid.Row="2" Grid.Column="1" DataSource="CustomersSource" DataField="Joined" Header="Customer since"/>
                <rw:DBCheckBox x:Name="ActiveCheck" Grid.Row="3" DataSource="CustomersSource" DataField="Active" Text="Active customer"/>
                <rw:DBToggleSwitch x:Name="NewsletterSwitch" Grid.Row="3" Grid.Column="1" DataSource="CustomersSource" DataField="Newsletter"
                                   ValueChecked="Y" ValueUnchecked="N" Header="Newsletter"/>
              </Grid>
              <rw:DBMemo x:Name="NotesMemo" DataSource="CustomersSource" DataField="Notes" Header="Notes" Height="72"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- The orders of the current customer (a detail table), and every customer as a tile -->
        <Grid Grid.Row="2" ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource Card}">
            <Grid RowSpacing="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Style="{StaticResource CardTitle}" Text="Orders of this customer"/>
                </StackPanel>
                <rw:DBNavigator x:Name="OrdersNavigator" AutomationProperties.Name="Orders navigator" Grid.Column="1" DataSource="OrdersSource"
                                VisibleButtons="First, Prior, Next, Last, Insert, Delete, Post, Cancel"/>
              </Grid>
              <!-- The cells can be edited here. Sorting is off, the detail keeps its master's order -->
              <rw:DBGrid x:Name="OrdersGrid" AutomationProperties.Name="Orders" Grid.Row="1" DataSource="OrdersSource" SortOnHeaderClick="False" Width="Auto" Height="180"
                         Columns="OrderNo:80, OrderDate:110, Product:200, Quantity:60, Total:100, Shipped:80"/>
            </Grid>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource Card}">
            <Grid RowSpacing="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Style="{StaticResource CardTitle}" Text="All customers"/>
                <TextBlock Style="{StaticResource CardClass}" Text="TWinUIDBCtrlGrid"/>
              </StackPanel>
              <rw:DBCtrlGrid x:Name="CustomerTiles" AutomationProperties.Name="Customer tiles" Grid.Row="1" DataSource="CustomersSource" Tiles="True" ReadOnly="True"
                             ItemTemplate="{StaticResource CustomerTile}" Width="Auto" Height="158"/>
            </Grid>
          </Border>
        </Grid>

        <!-- What the data sets are doing -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#22C3A6" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" FontSize="13" Foreground="{ThemeResource MutedBrush}" Text="Ready"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
