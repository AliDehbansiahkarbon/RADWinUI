<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TMainWindow" DataContextType="TMainViewModel"
    Title="Haven - savings and goals" Width="1360" Height="900" MinWidth="980" MinHeight="680"
    WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True">
  <!-- Glass over our own warm background: the cards use an in-app AcrylicBrush,
       which blurs the soft colour blobs drawn behind them. -->
  <Grid x:Name="Surface" RequestedTheme="Light" Background="#C9AE93">
    <Grid.Resources>
      <AcrylicBrush x:Key="GlassBrush" TintColor="#FFF8F0" TintOpacity="0.08" TintLuminosityOpacity="0.32" FallbackColor="#D9EFE4D8"/>
      <AcrylicBrush x:Key="GlassStrongBrush" TintColor="#FFFFFF" TintOpacity="0.20" TintLuminosityOpacity="0.55" FallbackColor="#E6F7F1EA"/>
      <SolidColorBrush x:Key="GlassBorderBrush" Color="#8CFFFFFF"/>
      <SolidColorBrush x:Key="CoralBrush" Color="#F26B4F"/>
      <SolidColorBrush x:Key="InkBrush" Color="#2B2622"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#7A6F66"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#F26B4F"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#F47E65"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#D95A40"/>
      <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="26"/>
      </Style>
      <Style x:Key="RailButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      </Style>
      <Style x:Key="TabButton" TargetType="Button">
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- The warm abstract background: large soft colour blobs -->
    <Grid Grid.RowSpan="4" IsHitTestVisible="False">
      <Ellipse Width="900" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-180,0,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#F0E0965F" Offset="0"/>
            <GradientStop Color="#00E0965F" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="1000" Height="820" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-260,0">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#E8B07A4E" Offset="0"/>
            <GradientStop Color="#00B07A4E" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="1100" Height="760" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-300">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#D8F6E7D2" Offset="0"/>
            <GradientStop Color="#00F6E7D2" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="80,0,0,-160">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#D86E4630" Offset="0"/>
            <GradientStop Color="#006E4630" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,120,40">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#B0E2795A" Offset="0"/>
            <GradientStop Color="#00E2795A" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
    </Grid>

    <Grid x:Name="DragRegion" Background="Transparent"/>

    <!-- Top bar -->
    <Border Grid.Row="1" Style="{StaticResource GlassCard}" CornerRadius="30" Margin="28,0,28,0" Padding="10,8">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <PersonPicture DisplayName="{Binding UserName}" d:DisplayName="Alex" Width="40" Height="40"/>
          <TextBlock x:Name="WelcomeText" Text="{Binding UserName, Converter={StaticResource Format}, ConverterParameter='Welcome, %s'}"
                     d:Text="Welcome, Alex" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
        </StackPanel>
        <Border Grid.Column="1" MaxWidth="560" HorizontalAlignment="Center" CornerRadius="22" Padding="12,0,6,0"
                Background="{StaticResource GlassStrongBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Ellipse Width="20" Height="20" VerticalAlignment="Center">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#7B8CFF" Offset="0"/>
                  <GradientStop Color="#C56CF0" Offset="0.5"/>
                  <GradientStop Color="#F26B4F" Offset="1"/>
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <TextBox x:Name="AskBox" Grid.Column="1" MinWidth="380" BorderThickness="0" Background="Transparent"
                     PlaceholderText="Ask anything, e.g. move $250 to Travel" VerticalAlignment="Center"
                     AutomationProperties.Name="Ask Haven"/>
          </Grid>
        </Border>
        <Grid Grid.Column="2">
          <Button Width="40" Height="40" CornerRadius="20" Padding="0" Background="White" BorderThickness="0"
                  ToolTipService.ToolTip="Notifications" AutomationProperties.Name="Notifications">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEA8F;" FontSize="16" Foreground="{StaticResource InkBrush}"/>
          </Button>
          <Ellipse Width="9" Height="9" Fill="{StaticResource CoralBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,6,7,0" IsHitTestVisible="False"/>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="20,20,28,16" ColumnSpacing="18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Icon rail -->
      <Border Style="{StaticResource GlassCard}" CornerRadius="32" Padding="8,12" VerticalAlignment="Center">
        <StackPanel Spacing="8">
          <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Home" AutomationProperties.Name="Home">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE80F;" FontSize="16"/>
          </Button>
          <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Activity" AutomationProperties.Name="Activity">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE945;" FontSize="16"/>
          </Button>
          <Button Style="{StaticResource RailButton}" Background="White" ToolTipService.ToolTip="Savings" AutomationProperties.Name="Savings">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE825;" FontSize="16"/>
          </Button>
          <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Schedule" AutomationProperties.Name="Schedule">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE787;" FontSize="16"/>
          </Button>
          <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Reports" AutomationProperties.Name="Reports">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEB05;" FontSize="16"/>
          </Button>
          <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Video call" AutomationProperties.Name="Video call">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE714;" FontSize="16"/>
          </Button>
          <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="16"/>
          </Button>
          <Button Style="{StaticResource RailButton}" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70D;" FontSize="12"/>
          </Button>
        </StackPanel>
      </Border>

      <!-- The main glass panel -->
      <Border Grid.Column="1" Style="{StaticResource GlassCard}" CornerRadius="34">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="40,32,40,32" Spacing="24">
            <Grid>
              <StackPanel Spacing="6">
                <TextBlock Text="Savings &amp; Goals" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="Set money aside for the things that matter and watch it grow." FontSize="14" Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
              <Button x:Name="NewGoalButton" Click="NewGoalClick" HorizontalAlignment="Right" VerticalAlignment="Top"
                      CornerRadius="20" Padding="16,9" Background="{StaticResource GlassStrongBrush}"
                      BorderBrush="{StaticResource GlassBorderBrush}" AutomationProperties.Name="New goal">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="12"/>
                  <TextBlock Text="New goal" FontSize="13"/>
                </StackPanel>
              </Button>
            </Grid>

            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
              </Grid.ColumnDefinitions>

              <!-- Total saved and the monthly chart -->
              <Border Style="{StaticResource GlassCard}" Padding="26,22">
                <Grid ColumnSpacing="28">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Total saved" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="TotalLabel" Text="{Binding TotalText}" d:Text="$10,937.95" FontSize="40" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display" Foreground="{StaticResource InkBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Background="#2629A36A" CornerRadius="9" Padding="7,2">
                        <TextBlock Text="+2%" FontSize="11" FontWeight="SemiBold" Foreground="#1F7A4D"/>
                      </Border>
                      <TextBlock Text="more than last quarter" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding TotalProgress}" d:Value="45" Maximum="100" Height="6" Margin="0,18,0,0"
                                 Foreground="{StaticResource CoralBrush}" Background="#40FFFFFF" CornerRadius="3"/>
                    <TextBlock x:Name="ProgressLabel" Text="{Binding ProgressCaption}" d:Text="45% of $24,300 across 5 goals"
                               FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Text="Monthly contributions" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                    <Grid Height="160" ColumnSpacing="14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Height="{Binding Bar1}" d:Height="60" VerticalAlignment="Bottom" CornerRadius="10" Background="#B3FFFFFF" BorderBrush="#E6FFFFFF" BorderThickness="1"/>
                      <Border Grid.Column="1" Height="{Binding Bar2}" d:Height="90" VerticalAlignment="Bottom" CornerRadius="10" Background="#B3FFFFFF" BorderBrush="#E6FFFFFF" BorderThickness="1"/>
                      <Border Grid.Column="2" Height="{Binding Bar3}" d:Height="56" VerticalAlignment="Bottom" CornerRadius="10" Background="#B3FFFFFF" BorderBrush="#E6FFFFFF" BorderThickness="1"/>
                      <Border Grid.Column="3" Height="{Binding Bar4}" d:Height="110" VerticalAlignment="Bottom" CornerRadius="10" Background="#B3FFFFFF" BorderBrush="#E6FFFFFF" BorderThickness="1"/>
                      <Border Grid.Column="4" Height="{Binding Bar5}" d:Height="86" VerticalAlignment="Bottom" CornerRadius="10" Background="#B3FFFFFF" BorderBrush="#E6FFFFFF" BorderThickness="1"/>
                      <Border Grid.Column="5" x:Name="CurrentMonthBar" Height="{Binding Bar6}" d:Height="130" VerticalAlignment="Bottom" CornerRadius="10" Background="{StaticResource CoralBrush}" Opacity="0.85"/>
                    </Grid>
                    <Grid ColumnSpacing="14">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Nov" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="1" Text="Dec" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="2" Text="Jan" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="3" Text="Feb" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="4" Text="Mar" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                      <TextBlock Grid.Column="5" Text="Apr" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Auto-save rules -->
              <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="22,20">
                <StackPanel Spacing="14">
                  <Grid>
                    <TextBlock Text="Auto-save" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <Border HorizontalAlignment="Right" Background="#2629A36A" CornerRadius="10" Padding="9,3">
                      <TextBlock x:Name="AutoSaveLabel" Text="{Binding AutoSaveCaption}" d:Text="2 on" FontSize="11" FontWeight="SemiBold" Foreground="#1F7A4D"/>
                    </Border>
                  </Grid>
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="12" Background="#99FFFFFF">
                      <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE895;" FontSize="15" Foreground="{StaticResource InkBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Round-ups" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                      <TextBlock Text="Round every card payment up to the next dollar" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="RoundUpsSwitch" Grid.Column="2" IsOn="{Binding RoundUps, Mode=TwoWay}" OnContent="" OffContent=""
                                  MinWidth="0" AutomationProperties.Name="Round-ups"/>
                  </Grid>
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="12" Background="#99FFFFFF">
                      <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C7;" FontSize="15" Foreground="{StaticResource InkBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Payday boost" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                      <TextBlock Text="Move 10% of every salary into your goals" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="PaydaySwitch" Grid.Column="2" IsOn="{Binding PaydayBoost, Mode=TwoWay}" OnContent="" OffContent=""
                                  MinWidth="0" AutomationProperties.Name="Payday boost"/>
                  </Grid>
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="12" Background="#99FFFFFF">
                      <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8AB;" FontSize="15" Foreground="{StaticResource InkBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="Smart sweep" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                      <TextBlock Text="Sweep what is left at the end of the month" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="SweepSwitch" Grid.Column="2" IsOn="{Binding SmartSweep, Mode=TwoWay}" OnContent="" OffContent=""
                                  MinWidth="0" AutomationProperties.Name="Smart sweep"/>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Goal cards: click a card (or its Add money pill) to add $100 -->
            <GridView x:Name="GoalGrid" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="GoalClick" Padding="0" AutomationProperties.Name="Goals">
              <GridView.ItemTemplate>
                <DataTemplate x:DataType="TGoal">
                  <Grid Width="176" Height="276">
                    <Border Style="{StaticResource GlassCard}" CornerRadius="24" Padding="16"
                            Visibility="{Binding IsNewCard, Converter={StaticResource InverseBoolToVisibility}}">
                      <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                          <Border Width="34" Height="34" CornerRadius="11" Background="#99FFFFFF" HorizontalAlignment="Left">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="{Binding Glyph}" FontSize="14" Foreground="{StaticResource CoralBrush}"/>
                          </Border>
                          <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="9" Padding="8,2" Background="#99FFFFFF">
                            <TextBlock Text="{Binding DueText}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                          </Border>
                        </Grid>
                        <Grid Grid.Row="1" Width="100" Height="100">
                          <ProgressRing IsIndeterminate="False" Value="{Binding Percent}" Maximum="100" Width="100" Height="100"
                                        Foreground="{StaticResource CoralBrush}" Background="#66FFFFFF"/>
                          <TextBlock Text="{Binding PercentText}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkBrush}"/>
                          <TextBlock Text="{Binding AmountText}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <Border Grid.Row="3" CornerRadius="16" Padding="0,7" Background="#CCFFFFFF">
                          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="10" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="Add money" FontSize="12" Foreground="{StaticResource InkBrush}"/>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                    <Grid Visibility="{Binding IsNewCard, Converter={StaticResource BoolToVisibility}}">
                      <Rectangle RadiusX="24" RadiusY="24" Stroke="#B3FFFFFF" StrokeThickness="1.5" StrokeDashArray="5,4" Fill="#1AFFFFFF"/>
                      <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26" Background="#CCFFFFFF" HorizontalAlignment="Center">
                          <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="18" Foreground="{StaticResource InkBrush}"/>
                        </Border>
                        <TextBlock Text="New goal" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Start saving for something new" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </GridView.ItemTemplate>
            </GridView>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Bottom tab bar -->
    <Border Grid.Row="3" Style="{StaticResource GlassCard}" CornerRadius="28" Padding="10,6" Margin="0,0,0,20" HorizontalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Style="{StaticResource TabButton}" Content="Overview"/>
        <Button Style="{StaticResource TabButton}" Content="Activity"/>
        <Button Style="{StaticResource TabButton}" Content="Manage" Background="#B3FFFFFF"/>
        <Button Style="{StaticResource TabButton}" Content="Program"/>
        <Button Style="{StaticResource TabButton}" Content="Account"/>
        <Button Style="{StaticResource TabButton}" Content="Reports"/>
        <Button x:Name="QuickAddButton" Click="NewGoalClick" Width="40" Height="40" CornerRadius="20" Padding="0" Margin="8,0,0,0"
                Background="White" BorderThickness="0" ToolTipService.ToolTip="New goal" AutomationProperties.Name="Add a goal">
          <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="14" Foreground="{StaticResource InkBrush}"/>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
