<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TQuillWindow"
    Title="Quill" Width="1100" Height="720" MinWidth="760" MinHeight="480"
    WindowStartupLocation="CenterScreen" Backdrop="Mica" ExtendsContentIntoTitleBar="True">
  <!-- Every colour is a theme resource, so Quill follows light, dark and the accent colour.
       Every text comes from Strings\<language>\Resources.resw through x:Uid. -->
  <Grid>
    <Grid.Resources>
      <ResourceDictionary>
        <Style x:Key="ToolButton" TargetType="Button">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Padding" Value="10,6"/>
          <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
          <Setter Property="FontSize" Value="12"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Opacity" Value="0.7"/>
        </Style>
      </ResourceDictionary>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Title bar: the whole row drags the window -->
    <Grid x:Name="DragRegion" Grid.ColumnSpan="3" Background="Transparent"/>
    <StackPanel x:Name="TitleRow" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center"
                IsHitTestVisible="False">
      <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
      <TextBlock Text="Quill" FontWeight="SemiBold"/>
      <TextBlock x:Name="TitleNote" Opacity="0.7" d:Text="Welcome"/>
    </StackPanel>

    <!-- Notes -->
    <Grid Grid.Row="1" Padding="12,4,8,12" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Uid="NotesHeader" Style="{StaticResource SectionTitle}" Margin="8,0,0,0"/>
      <ListView x:Name="NoteList" Grid.Row="1" SelectionMode="Single" SelectionChanged="NoteListSelectionChanged"
                x:Uid="NoteList">
        <d:ListView.Items>
          <x:String>Welcome</x:String>
          <x:String>Shopping list</x:String>
        </d:ListView.Items>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="TQuillNote">
            <StackPanel Padding="0,8">
              <TextBlock Text="{Binding Title}" d:Text="{Binding}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Subtitle}" d:Text="Not saved yet" FontSize="12" Opacity="0.65"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
        <Button x:Name="NewButton" x:Uid="NewButton" Style="{StaticResource AccentButtonStyle}" Click="NewClick">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock x:Uid="NewText"/></StackPanel>
        </Button>
        <Button x:Name="ImportButton" x:Uid="ImportButton" Click="ImportClick">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B5;" FontSize="14"/><TextBlock x:Uid="ImportText"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Editor -->
    <Grid Grid.Row="1" Grid.Column="1" Margin="4,4,12,12" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid ColumnSpacing="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Uid="OpenButton" Style="{StaticResource ToolButton}" Click="OpenClick">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="14"/><TextBlock x:Uid="OpenText"/></StackPanel>
            </Button>
            <Button x:Uid="SaveButton" Style="{StaticResource ToolButton}" Click="SaveClick">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="14"/><TextBlock x:Uid="SaveText"/></StackPanel>
            </Button>
            <Button x:Uid="SaveAsButton" Style="{StaticResource ToolButton}" Click="SaveAsClick">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE792;" FontSize="14"/><TextBlock x:Uid="SaveAsText"/></StackPanel>
            </Button>
            <Button x:Uid="RenameButton" Style="{StaticResource ToolButton}" Click="RenameClick">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8AC;" FontSize="14"/><TextBlock x:Uid="RenameText"/></StackPanel>
            </Button>
            <Button x:Uid="CloseNoteButton" Style="{StaticResource ToolButton}" Click="CloseNoteClick">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE711;" FontSize="14"/><TextBlock x:Uid="CloseNoteText"/></StackPanel>
            </Button>
            <AppBarSeparator/>
            <Button x:Uid="RemindButton" Style="{StaticResource ToolButton}">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE823;" FontSize="14"/><TextBlock x:Uid="RemindText"/></StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuFlyoutItem x:Name="RemindSoon" x:Uid="RemindSoon" Click="RemindSoonClick"/>
                  <MenuFlyoutItem x:Name="RemindMinute" x:Uid="RemindMinute" Click="RemindMinuteClick"/>
                  <MenuFlyoutItem x:Name="RemindTen" x:Uid="RemindTen" Click="RemindTenClick"/>
                  <MenuFlyoutSeparator/>
                  <MenuFlyoutItem x:Name="RemindCancel" x:Uid="RemindCancel" Click="RemindCancelClick"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Uid="ExportButton" Style="{StaticResource ToolButton}" Click="ExportClick">
              <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEDE1;" FontSize="14"/><TextBlock x:Uid="ExportText"/></StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <AppBarSeparator/>
          <Button x:Uid="SettingsButton" Style="{StaticResource ToolButton}" Click="SettingsClick">
            <FontIcon Glyph="&#xE713;" FontSize="14"/>
          </Button>
          <Button x:Uid="AboutButton" Style="{StaticResource ToolButton}" Click="AboutClick">
            <FontIcon Glyph="&#xE946;" FontSize="14"/>
          </Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <TextBox x:Name="Editor" x:Uid="Editor" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                 Padding="24,20" FontSize="15" TextChanged="EditorChanged"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
      </Border>
      <TextBlock x:Name="Status" Grid.Row="2" Margin="4,0,0,0" FontSize="12" Opacity="0.7" d:Text="12 words  ·  Saved"/>
    </Grid>

    <!-- Settings, shown beside the editor -->
    <Border x:Name="SettingsPanel" Grid.Row="1" Grid.Column="2" Width="300" Margin="0,4,12,12" Padding="20" CornerRadius="8"
            BorderThickness="1" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <TextBlock x:Uid="SettingsTitle" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Uid="LanguageHeader" Style="{StaticResource SectionTitle}" Margin="0,8,0,0"/>
          <ComboBox x:Name="LanguageBox" x:Uid="LanguageBox" HorizontalAlignment="Stretch" SelectionChanged="LanguageChanged">
            <ComboBoxItem x:Uid="LanguageSystem"/>
            <ComboBoxItem Content="English"/>
            <ComboBoxItem Content="Deutsch"/>
            <ComboBoxItem Content="&#x0641;&#x0627;&#x0631;&#x0633;&#x06CC;"/>
          </ComboBox>
          <TextBlock x:Uid="LanguageInfo" TextWrapping="Wrap" Opacity="0.8"/>
          <TextBlock x:Uid="LaunchHeader" Style="{StaticResource SectionTitle}" Margin="0,8,0,0"/>
          <TextBlock x:Name="LaunchInfo" TextWrapping="Wrap" IsTextSelectionEnabled="True" d:Text="Launch"/>
          <TextBlock x:Uid="FilesHeader" Style="{StaticResource SectionTitle}" Margin="0,8,0,0"/>
          <TextBlock x:Uid="FilesInfo" TextWrapping="Wrap" Opacity="0.8"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="RegisterFiles" Click="RegisterFilesClick"/>
            <Button x:Uid="UnregisterFiles" Click="UnregisterFilesClick"/>
          </StackPanel>
          <TextBlock x:Uid="LinksHeader" Style="{StaticResource SectionTitle}" Margin="0,8,0,0"/>
          <TextBlock x:Uid="LinksInfo" TextWrapping="Wrap" Opacity="0.8"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Uid="RegisterLinks" Click="RegisterLinksClick"/>
            <Button x:Uid="UnregisterLinks" Click="UnregisterLinksClick"/>
          </StackPanel>
          <TextBlock x:Name="SettingsResult" TextWrapping="Wrap" Opacity="0.8" Margin="0,8,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
