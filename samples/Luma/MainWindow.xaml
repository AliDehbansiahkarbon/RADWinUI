<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="TMainWindow" DataContextType="TMainViewModel"
    Title="Luma - your day, at a glance" Width="420" Height="1040"
    MinWidth="390" MinHeight="620" Backdrop="Acrylic" ExtendsContentIntoTitleBar="True">
  <!-- The transparent root exposes real desktop Acrylic. ThemeResource values
       follow Windows light/dark mode, accent color and high contrast. -->
  <Grid x:Name="Surface" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="52"/>
    </Grid.RowDefinitions>
    <Grid x:Name="DragRegion" Margin="24,0,140,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" x:Name="LumaGlyph" Glyph="&#xE8A9;" FontSize="18" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
        <TextBlock Text="LUMA" FontSize="13" FontWeight="SemiBold" CharacterSpacing="180"/>
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Padding="24,12,24,20" Spacing="20">
        <StackPanel Spacing="3">
          <TextBlock Text="A little clarity for your day." FontSize="13"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <Grid>
            <TextBlock x:Name="ClockLabel" Text="{Binding ClockText}" d:Text="09:41"
                       FontFamily="Segoe UI Variable Display" FontSize="76" FontWeight="SemiLight"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="5" Height="5" Fill="{ThemeResource SystemControlForegroundAccentBrush}"/>
                <TextBlock Text="LOCAL" FontSize="10" FontWeight="SemiBold" CharacterSpacing="100"/>
              </StackPanel>
            </Border>
          </Grid>
          <TextBlock x:Name="DateLabel" Text="{Binding DateText}" d:Text="Monday, 19 October 2026" FontSize="15"/>
        </StackPanel>
        <Border Padding="18,14" CornerRadius="16" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
          <StackPanel Spacing="10">
            <Grid>
              <TextBlock Text="TODAY" FontSize="10" FontWeight="SemiBold" CharacterSpacing="160"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="{Binding DayCaption}" d:Text="40% of the day" HorizontalAlignment="Right" FontSize="11"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <ProgressBar Value="{Binding DayProgress}" d:Value="40" Maximum="100" Height="3"/>
          </StackPanel>
        </Border>
        <Border Padding="20" CornerRadius="20" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0"/>
              <GradientStop Color="{ThemeResource SystemAccentColorDark2}" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE708;" FontSize="14" Foreground="White"/>
              <TextBlock Text="MAKE SPACE TO FOCUS" Foreground="White" FontSize="10"
                         FontWeight="SemiBold" CharacterSpacing="130"/>
            </StackPanel>
            <Grid>
              <TextBlock Text="{Binding FocusText}" d:Text="25:00" Foreground="White"
                         FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="48"/>
              <TextBlock Text="One thing at a time." Foreground="White" Opacity="0.85" FontSize="11"
                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <ProgressBar Value="{Binding FocusProgress}" Maximum="100" Foreground="White" Background="#30FFFFFF" Height="3"/>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="FocusButton" Content="{Binding FocusAction}" d:Content="Start focus"
                      Click="FocusClick" HorizontalAlignment="Stretch" Foreground="White"
                      Background="#24FFFFFF" BorderBrush="#50FFFFFF" CornerRadius="10"/>
              <Button Grid.Column="1" Click="ResetClick" ToolTipService.ToolTip="Reset to 25 minutes"
                      AutomationProperties.Name="Reset focus timer" Background="#18FFFFFF"
                      BorderBrush="#40FFFFFF" CornerRadius="10">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE72C;" Foreground="White" FontSize="14"/>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Padding="16" CornerRadius="16" BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" x:Name="PowerGlyph" Glyph="&#xE83E;" FontSize="13" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                <TextBlock Text="POWER" FontSize="10" CharacterSpacing="100"/>
              </StackPanel>
              <TextBlock Text="{Binding PowerText}" d:Text="86%" FontSize="23" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding PowerCaption}" d:Text="On battery" FontSize="11"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Padding="16" CornerRadius="16" BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" x:Name="MemoryGlyph" Glyph="&#xE950;" FontSize="13" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                <TextBlock Text="MEMORY" FontSize="10" CharacterSpacing="100"/>
              </StackPanel>
              <TextBlock Text="{Binding MemoryText}" d:Text="42%" FontSize="23" FontWeight="SemiBold"/>
              <TextBlock Text="Physical memory in use" FontSize="11"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </Border>
        </Grid>
        <StackPanel Spacing="10">
          <TextBlock Text="A LOOK AHEAD" FontSize="10" FontWeight="SemiBold" CharacterSpacing="150"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <CalendarView x:Name="MonthCalendar" HorizontalAlignment="Stretch" Height="360"
                        SelectionMode="Single" IsTodayHighlighted="True" CornerRadius="16"/>
        </StackPanel>
        <TextBlock Text="Built in Delphi. Brought to life by WinUI 3." FontSize="11" HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="24,0" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="ThemeChoice" SelectedIndex="0" SelectionChanged="ThemeChanged"
                AutomationProperties.Name="Appearance" VerticalAlignment="Center" MinWidth="146">
        <ComboBoxItem Content="Windows theme"/>
        <ComboBoxItem Content="Light"/>
        <ComboBoxItem Content="Dark"/>
      </ComboBox>
      <ToggleSwitch x:Name="TransparencySwitch" OnContent="Transparency" OffContent="Transparency" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Transparency" Grid.Column="1"/>
      <ToggleButton x:Name="PinButton" Grid.Column="2" Click="PinClick" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Keep Luma above other windows" AutomationProperties.Name="Keep on top">
        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" x:Name="PinGlyph" Glyph="&#xE718;" FontSize="14"/>
      </ToggleButton>
    </Grid>
  </Grid>
</Window>
